<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<% const mode = (locals.mode === 'magic') ? 'magic' : 'password'; %>

<div class="min-h-screen flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <% if (mode === 'magic') { %>
        <h1 class="text-2xl font-bold text-gray-900">Create your account</h1>
        <p class="text-gray-500 mt-1 text-sm">No password — we'll email you a one-tap sign-in link.</p>
      <% } else { %>
        <h1 class="text-2xl font-bold text-gray-900">Create your account</h1>
        <p class="text-gray-500 mt-1 text-sm">Free forever — no credit card needed</p>
      <% } %>
    </div>

    <% if (locals.flash) { %>
      <div class="mb-4 p-3 rounded-lg text-sm <%= flash.type === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <% if (locals.sent) { %>
      <div data-testid="register-magic-success" class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="text-3xl mb-2">📬</div>
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Check your inbox</h2>
        <p class="text-sm text-gray-600">
          We've sent a one-tap sign-in link to <strong><%= locals.submittedEmail || '' %></strong>. Click it to finish creating your account and land on your dashboard.
        </p>
        <p class="text-xs text-gray-400 mt-4">
          Didn't get it? Check your spam folder, then <a href="/auth/register?mode=magic" class="text-brand-600 hover:underline">request another link</a>.
        </p>
      </div>
    <% } else if (mode === 'magic') { %>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
        <form action="/auth/register/magic" method="POST" class="space-y-4" data-testid="register-magic-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Your name</label>
            <input type="text" name="name" required autocomplete="name"
              value="<%= locals.values ? values.name : '' %>"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="email" required autocomplete="email"
              value="<%= locals.values ? values.email : '' %>"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <button type="submit" class="w-full bg-brand-600 text-white font-semibold py-2.5 rounded-lg hover:bg-brand-700 transition">
            Email me a sign-up link &rarr;
          </button>
          <p class="text-xs text-gray-400 text-center">By signing up, you agree to receive transactional emails about your account.</p>
        </form>
      </div>
      <p class="text-center text-sm text-gray-500 mt-4">
        Prefer a password? <a href="/auth/register" class="text-brand-600 font-medium hover:underline" data-testid="register-switch-to-password">Sign up with a password &rarr;</a>
      </p>
    <% } else { %>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
        <form action="/auth/register" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Your name</label>
            <input type="text" name="name" required autocomplete="name"
              value="<%= locals.values ? values.name : '' %>"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="email" required autocomplete="email"
              value="<%= locals.values ? values.email : '' %>"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Password <span class="text-gray-400 font-normal">(8+ characters)</span></label>
            <input type="password" name="password" required autocomplete="new-password" minlength="8"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <button type="submit" class="w-full bg-brand-600 text-white font-semibold py-2.5 rounded-lg hover:bg-brand-700 transition">
            Create account &rarr;
          </button>
          <p class="text-xs text-gray-400 text-center">By signing up, you agree to receive transactional emails about your account.</p>
        </form>
      </div>
      <p class="text-center text-sm text-gray-500 mt-4">
        Skip the password? <a href="/auth/register?mode=magic" class="text-brand-600 font-medium hover:underline" data-testid="register-switch-to-magic">Sign up with just your email &rarr;</a>
      </p>
    <% } %>

    <p class="text-center text-sm text-gray-500 mt-6">
      Already have an account? <a href="/auth/login" class="text-brand-600 font-medium hover:underline">Log in</a>
    </p>
    <p class="text-center text-xs text-gray-400 mt-3">
      By creating an account, you agree to our <a href="/terms" class="underline hover:text-gray-600">Terms</a> and <a href="/privacy" class="underline hover:text-gray-600">Privacy Policy</a>.
    </p>
  </div>
</div>

<%- include('../partials/footer') %>

</body>
</html>
