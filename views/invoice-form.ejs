<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  const recentClientsList = (locals.recentClients && Array.isArray(recentClients)) ? recentClients : [];
  // Recent items quick-pick — same shape contract as /invoices/quick but
  // applied per-line-item on the advanced form. Picking populates the next
  // empty line (or appends a new one) with description + quantity + unit_price
  // so a freelancer who bills "Hourly rate · qty=4 · $150/hr" repeatedly
  // never re-types the breakdown. Empty list → dropdown omitted entirely
  // (no useless empty <select> shipping to day-zero users).
  const rawRecentItemsNew = (locals.recentItems && Array.isArray(recentItems))
    ? recentItems : [];
  const recentItemsListNew = rawRecentItemsNew
    .filter(it => it
      && typeof it.description === 'string'
      && it.description.trim().length > 0
      && Number.isFinite(Number(it.unit_price))
      && Number(it.unit_price) > 0)
    .map(it => {
      const qtyRaw = Number(it.quantity);
      const qty = Number.isFinite(qtyRaw) && qtyRaw > 0 ? qtyRaw : 1;
      const unit = Number(it.unit_price);
      return {
        description: String(it.description).trim().slice(0, 80),
        quantity: qty,
        unit_price: unit,
        amount: qty * unit
      };
    });
  const initialClient = {
    name: invoice ? (invoice.client_name || '') : '',
    email: invoice && invoice.client_email ? invoice.client_email : '',
    address: invoice && invoice.client_address ? invoice.client_address : ''
  };
  // Inline business_name + payment_instructions capture, mirroring
  // /invoices/quick. A user who lands on the advanced form because they need
  // line items / tax / custom dates still ships their first invoice — and
  // the same activation gap applies: without business_name the rendered
  // header reads "Your Business" and the public share page introduces them
  // as "A DecentInvoice user"; without payment_instructions the free-plan
  // share link offers no way to actually pay. Edit-flow (`invoice` set)
  // suppresses the blocks — the user is past activation by then. Server-
  // side gating in POST /invoices/new is the canonical guard against
  // forged payloads.
  const planNameNew = (locals.user && typeof user.plan === 'string') ? user.plan : 'free';
  const ownerBusinessNameNew = (locals.user && typeof user.business_name === 'string')
    ? user.business_name.trim() : '';
  const showBusinessNameCaptureNew = !invoice && ownerBusinessNameNew.length === 0;
  const ownerPaymentInstructionsNew = (locals.user && typeof user.payment_instructions === 'string')
    ? user.payment_instructions.trim() : '';
  const showPaymentInstructionsCaptureNew = !invoice
    && planNameNew === 'free'
    && ownerPaymentInstructionsNew.length === 0;
  // "Create & email to client" combined action (Milestone 3 — first invoice
  // created → first invoice sent). Mirrors the proven /invoices/quick dual-
  // CTA pattern: Pro/Agency users on the advanced form collapse create →
  // land on /:id → tap Send into a single submit. Edit-flow ("invoice" set)
  // and free/trial users keep the single primary button — free can't email
  // from the app and edit isn't the activation surface.
  const canEmailFromFormNew = !invoice && (planNameNew === 'pro' || planNameNew === 'agency');
  const submittedNew = (locals.submitted && typeof submitted === 'object') ? submitted : {};
  const initialBusinessNameNew = typeof submittedNew.business_name === 'string'
    ? submittedNew.business_name : '';
  const initialPaymentInstructionsNew = typeof submittedNew.payment_instructions === 'string'
    ? submittedNew.payment_instructions : '';
%>
<div class="max-w-4xl mx-auto px-4 py-10" x-data="invoiceEditor(<%= JSON.stringify(invoice ? invoice.items : []) %>, <%= JSON.stringify(recentClientsList) %>, <%= JSON.stringify(initialClient) %>, <%= JSON.stringify(invoice ? [] : recentItemsListNew) %>)">
  <div class="flex items-center gap-3 mb-8">
    <a href="/invoices" class="text-gray-400 hover:text-gray-600 text-sm">← Invoices</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-2xl font-bold text-gray-900"><%= invoice ? 'Edit Invoice' : 'New Invoice' %></h1>
  </div>

  <% if (locals.flash) { %>
    <div class="mb-6 p-3 rounded-lg text-sm bg-red-50 text-red-700 border border-red-200">
      <%= flash.message %>
    </div>
  <% } %>

  <form action="/invoices/<%= invoice ? invoice.id + '/edit' : 'new' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

    <% if (showBusinessNameCaptureNew) { %>
      <div data-testid="invoice-new-business-name-block"
        class="mb-6 rounded-lg border border-sky-200 bg-sky-50 p-4">
        <label class="block text-sm font-semibold text-sky-900 mb-1" for="new-business-name">
          💼 Your business name <span class="text-sky-700 font-normal text-xs">(appears as the sender on every invoice)</span>
        </label>
        <p class="text-xs text-sky-800 mb-2">
          Without this your invoice will just say &ldquo;Your Business&rdquo; at the top &mdash; clients are less likely to pay something that doesn&rsquo;t look branded.
        </p>
        <input id="new-business-name" type="text" name="business_name"
          maxlength="255"
          data-testid="invoice-new-business-name-input"
          placeholder="Acme Studio, or your own name"
          value="<%= initialBusinessNameNew %>"
          class="w-full border border-sky-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400">
        <p class="text-xs text-sky-700 mt-2">
          Saved to your account &mdash; every invoice you share from now on will show this.
        </p>
      </div>
    <% } %>
    <div class="grid md:grid-cols-2 gap-6">

      <!-- Invoice Details -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Invoice Details</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Invoice Number</label>
            <input type="text" name="invoice_number" required
              value="<%= invoice ? invoice.invoice_number : invoiceNumber %>"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Issue Date</label>
              <input type="date" name="issued_date"
                value="<%= invoice ? invoice.issued_date.toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Due Date <span class="text-gray-400 font-normal text-xs">(defaults to 30 days)</span></label>
              <input type="date" name="due_date"
                value="<%= invoice && invoice.due_date ? invoice.due_date.toISOString().split('T')[0] : new Date(Date.now() + 30*86400000).toISOString().split('T')[0] %>"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            </div>
          </div>
          <% if (invoice) { %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select name="status" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <% ['draft','sent','paid','overdue'].forEach(s => { %>
                <option value="<%= s %>" <%= invoice.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Client Info -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Bill To</h2>
        <div class="space-y-4">
          <% if (recentClientsList.length > 0) { %>
          <div data-recent-clients>
            <label for="recent-client-picker" class="block text-sm font-medium text-gray-700 mb-1">Recent clients</label>
            <select id="recent-client-picker" x-model="picked" @change="fillFromRecent()"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Quick-pick from recent…</option>
              <% recentClientsList.forEach(function(c, idx) { %>
                <option value="<%= idx %>"><%= c.client_name %><%= c.client_email ? ' · ' + c.client_email : '' %></option>
              <% }) %>
            </select>
            <p class="text-xs text-gray-400 mt-1">Selecting fills the fields below — you can still edit them.</p>
          </div>
          <% } %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Client Name <span class="text-red-400">*</span></label>
            <input type="text" name="client_name" required x-model="clientName"
              placeholder="Acme Corp"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Client Email</label>
            <input type="email" name="client_email" x-model="clientEmail"
              placeholder="client@example.com"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Client Address</label>
            <textarea name="client_address" rows="3" placeholder="123 Main St&#10;City, State 12345" x-model="clientAddress"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Line Items -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mt-6">
      <h2 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Line Items</h2>

      <% if (!invoice && recentItemsListNew.length > 0) { %>
        <div data-recent-items data-testid="invoice-new-recent-items" class="mb-4">
          <label for="new-recent-item-picker" class="block text-sm font-medium text-gray-700 mb-1">Recent items</label>
          <select id="new-recent-item-picker"
            data-testid="invoice-new-recent-items-select"
            x-model="pickedItem" @change="fillFromRecentItem()"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="">Quick-pick a past item&hellip;</option>
            <% recentItemsListNew.forEach(function(it, idx) { %>
              <option value="<%= idx %>"><%= it.description %> &middot; qty <%= it.quantity %> &times; $<%= it.unit_price.toFixed(2) %></option>
            <% }) %>
          </select>
          <p class="text-xs text-gray-400 mt-1">Selecting fills (or adds) a line below &mdash; you can still edit it.</p>
        </div>
      <% } %>

      <!-- Header row -->
      <div class="grid grid-cols-12 gap-3 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">
        <div class="col-span-6">Description</div>
        <div class="col-span-2 text-center">Qty</div>
        <div class="col-span-2 text-right">Unit Price</div>
        <div class="col-span-2 text-right">Amount</div>
      </div>

      <template x-for="(item, i) in items" :key="i">
        <div class="grid grid-cols-12 gap-3 mb-2 items-center">
          <div class="col-span-6">
            <input type="text" x-model="item.description" placeholder="Service or product"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" required>
          </div>
          <div class="col-span-2">
            <input type="number" x-model.number="item.quantity" min="0" step="any"
              @input="recalculate()"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div class="col-span-2">
            <input type="number" x-model.number="item.unit_price" min="0" step="0.01" placeholder="0.00"
              @input="recalculate()"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-right focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div class="col-span-1 text-right text-sm font-medium text-gray-700" x-text="'$' + (item.quantity * item.unit_price).toFixed(2)"></div>
          <div class="col-span-1 text-right">
            <button type="button" @click="removeItem(i)" class="text-red-400 hover:text-red-600 text-lg leading-none" x-show="items.length > 1">×</button>
          </div>
        </div>
      </template>

      <button type="button" @click="addItem()"
        class="mt-3 text-brand-600 text-sm font-medium hover:text-brand-700 flex items-center gap-1">
        + Add line item
      </button>

      <!-- Totals -->
      <div class="mt-6 border-t border-gray-100 pt-4">
        <div class="flex flex-col items-end gap-2 text-sm">
          <div class="flex justify-between w-64">
            <span class="text-gray-500">Subtotal</span>
            <span class="font-medium" x-text="'$' + subtotal.toFixed(2)"></span>
          </div>
          <div class="flex items-center justify-between w-64">
            <div class="flex items-center gap-2">
              <span class="text-gray-500">Tax</span>
              <input type="number" x-model.number="taxRate" min="0" max="100" step="0.1"
                @input="recalculate()" placeholder="0"
                class="w-14 border border-gray-300 rounded px-2 py-1 text-xs text-center focus:outline-none focus:ring-2 focus:ring-brand-500">
              <span class="text-gray-400 text-xs">%</span>
            </div>
            <span class="font-medium" x-text="'$' + taxAmount.toFixed(2)"></span>
          </div>
          <div class="flex justify-between w-64 border-t border-gray-200 pt-2">
            <span class="font-semibold text-gray-700">Total</span>
            <span class="font-bold text-lg text-gray-900" x-text="'$' + total.toFixed(2)"></span>
          </div>
        </div>
      </div>

      <!-- Hidden fields for form submission -->
      <input type="hidden" name="items" :value="JSON.stringify(items)">
      <input type="hidden" name="subtotal" :value="subtotal.toFixed(2)">
      <input type="hidden" name="tax_rate" :value="taxRate">
      <input type="hidden" name="tax_amount" :value="taxAmount.toFixed(2)">
      <input type="hidden" name="total" :value="total.toFixed(2)">
    </div>

    <!-- Notes -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mt-6">
      <h2 class="font-semibold text-gray-700 mb-4 text-sm uppercase tracking-wide">Notes</h2>
      <textarea name="notes" rows="3" data-testid="invoice-form-notes" placeholder="Payment terms, bank details, thank you note..."
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= invoice ? (invoice.notes || '') : ((locals.user && user.default_invoice_notes) ? user.default_invoice_notes : '') %></textarea>
    </div>

    <% if (showPaymentInstructionsCaptureNew) { %>
      <div data-testid="invoice-new-payment-instructions-block"
        class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
        <label class="block text-sm font-semibold text-amber-900 mb-1" for="new-payment-instructions">
          💰 How will your client pay you? <span class="text-amber-700 font-normal text-xs">(optional, shows on the share link)</span>
        </label>
        <p class="text-xs text-amber-800 mb-2">
          On the free plan your share link has no Pay button — give your client a way to send the money. Venmo, Zelle, bank, cheque, anything.
        </p>
        <textarea id="new-payment-instructions" name="payment_instructions"
          rows="3" maxlength="2000"
          data-testid="invoice-new-payment-instructions-input"
          placeholder="Venmo @yourhandle&#10;Zelle: you@bank.com&#10;Bank: Chase, routing 021000021, acct 1234567890"
          class="w-full border border-amber-200 rounded-lg px-3 py-2 text-sm font-mono bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"><%= initialPaymentInstructionsNew %></textarea>
        <p class="text-xs text-amber-700 mt-2">
          Saved to your account — every invoice you share from now on will show these.
        </p>
      </div>
    <% } %>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-6">
      <a href="/invoices" class="text-gray-500 hover:text-gray-700 text-sm order-2 sm:order-1">Cancel</a>
      <div class="flex flex-col sm:flex-row gap-2 sm:items-center order-1 sm:order-2">
        <% if (canEmailFromFormNew) { %>
          <button type="submit"
            name="action" value="create_only"
            data-testid="invoice-new-submit-draft"
            class="text-brand-700 hover:text-brand-800 hover:underline text-sm font-medium px-4 py-3 text-center">
            Save as draft
          </button>
          <button type="submit"
            name="action" value="create_and_email"
            data-testid="invoice-new-submit-email"
            data-action="create_and_email"
            :disabled="!clientEmail || !clientEmail.trim()"
            :class="!clientEmail || !clientEmail.trim()
              ? 'bg-brand-300 text-white cursor-not-allowed'
              : 'bg-brand-600 text-white hover:bg-brand-700'"
            class="font-semibold px-6 py-3 rounded-xl transition">
            <span x-show="!clientEmail || !clientEmail.trim()">Add client email to send &darr;</span>
            <span x-show="clientEmail && clientEmail.trim()" x-cloak>📧 Create &amp; email to client &rarr;</span>
          </button>
        <% } else { %>
          <button type="submit"
            data-testid="invoice-new-submit"
            class="bg-brand-600 text-white font-semibold px-8 py-3 rounded-xl hover:bg-brand-700 transition">
            <% if (invoice) { %>Save changes<% } else { %>Create invoice &rarr;<% } %>
          </button>
        <% } %>
      </div>
    </div>
    <% if (canEmailFromFormNew) { %>
      <p class="text-xs text-gray-400 pt-1 text-right" data-testid="invoice-new-email-hint">
        &ldquo;Email to client&rdquo; sends the invoice straight to their inbox and marks it as sent in one tap.
      </p>
    <% } %>
  </form>
</div>

<script>
function invoiceEditor(initialItems, initialRecentClients, initialClient, initialRecentItems) {
  const c = initialClient && typeof initialClient === 'object' ? initialClient : {};
  return {
    items: initialItems && initialItems.length > 0
      ? initialItems.map(i => ({ description: i.description, quantity: Number(i.quantity), unit_price: Number(i.unit_price) }))
      : [{ description: '', quantity: 1, unit_price: 0 }],
    taxRate: <%= invoice ? Number(invoice.tax_rate) : 0 %>,
    subtotal: 0,
    taxAmount: 0,
    total: 0,
    recentClients: Array.isArray(initialRecentClients) ? initialRecentClients : [],
    recentItems: Array.isArray(initialRecentItems) ? initialRecentItems : [],
    picked: '',
    pickedItem: '',
    clientName: typeof c.name === 'string' ? c.name : '',
    clientEmail: typeof c.email === 'string' ? c.email : '',
    clientAddress: typeof c.address === 'string' ? c.address : '',

    init() { this.recalculate(); },

    fillFromRecent() {
      const idx = parseInt(this.picked, 10);
      if (Number.isNaN(idx) || idx < 0 || idx >= this.recentClients.length) return;
      const c = this.recentClients[idx];
      if (!c) return;
      this.clientName = c.client_name || '';
      this.clientEmail = c.client_email || '';
      this.clientAddress = c.client_address || '';
    },

    // Quick-pick a previously-billed line item. If the LAST line is empty
    // (default starter row with no description and zero unit_price), replace
    // it in place; otherwise append a fresh line. Either way the totals
    // recompute and the dropdown resets so the next pick is clean. Bad picks
    // (out-of-range, NaN, non-positive unit_price) no-op silently.
    fillFromRecentItem() {
      const idx = parseInt(this.pickedItem, 10);
      this.pickedItem = '';
      if (Number.isNaN(idx) || idx < 0 || idx >= this.recentItems.length) return;
      const it = this.recentItems[idx];
      if (!it || typeof it.description !== 'string') return;
      const qty = Number(it.quantity);
      const unit = Number(it.unit_price);
      if (!Number.isFinite(qty) || qty <= 0) return;
      if (!Number.isFinite(unit) || unit <= 0) return;
      const filled = { description: it.description, quantity: qty, unit_price: unit };
      const last = this.items[this.items.length - 1];
      const lastEmpty = last
        && (!last.description || String(last.description).trim() === '')
        && (!Number(last.unit_price) || Number(last.unit_price) === 0);
      if (lastEmpty) {
        this.items.splice(this.items.length - 1, 1, filled);
      } else {
        this.items.push(filled);
      }
      this.recalculate();
    },

    addItem() {
      this.items.push({ description: '', quantity: 1, unit_price: 0 });
    },
    removeItem(i) {
      this.items.splice(i, 1);
      this.recalculate();
    },
    recalculate() {
      this.subtotal = this.items.reduce((s, i) => s + (Number(i.quantity) * Number(i.unit_price)), 0);
      this.taxAmount = this.subtotal * (this.taxRate / 100);
      this.total = this.subtotal + this.taxAmount;
    }
  };
}
</script>

<%- include('partials/upgrade-modal') %>

<%- include('partials/footer') %>

</body>
</html>
