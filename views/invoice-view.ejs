<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  const statusColors = {
    draft: 'bg-gray-100 text-gray-600',
    sent: 'bg-blue-100 text-blue-700',
    paid: 'bg-green-100 text-green-700',
    overdue: 'bg-red-100 text-red-700'
  };
  // Currency-aware money formatter for the owner's view of an invoice.
  // The route threads `formatMoney` (lib/currency) + `currency` (resolved
  // ISO-4217 code) as render locals. Legacy callers (tests, ad-hoc
  // fixtures) that don't thread them fall back to the historical
  // `$X.XX` shape so a missing local never throws on render.
  const _viewFmt = (typeof formatMoney === 'function')
    ? formatMoney
    : function (amount) {
        const n = Number(amount);
        const safe = Number.isFinite(n) ? n : 0;
        return '$' + safe.toFixed(2);
      };
  const _viewCcy = (typeof currency === 'string' && currency) ? currency : 'USD';
%>

<div class="max-w-4xl mx-auto px-4 py-10">
  <div class="flex items-center gap-3 mb-6">
    <a href="/invoices" class="text-gray-400 hover:text-gray-600 text-sm">← Invoices</a>
    <span class="text-gray-300">/</span>
    <span class="text-gray-700 font-medium"><%= invoice.invoice_number %></span>
    <span class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full <%= statusColors[invoice.status] || 'bg-gray-100 text-gray-600' %>">
      <%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %>
    </span>
  </div>

  <% if (locals.flash) { %>
    <div class="mb-4 p-3 rounded-lg text-sm <%= flash.type === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200' %>">
      <%= flash.message %>
    </div>
  <% } %>

  <!-- Seed-invoice "this is a sample" banner (Milestone 2 — first dashboard
       re-entry → first real invoice created). A brand-new user who clicks
       the seed sample from the dashboard lands here and sees a normal
       invoice view whose most prominent button is "Mark as Sent" — a
       confusing dead-end on a placeholder row. The banner above the action
       bar reframes the page ("this is just a sample") and points the
       primary next-action at /invoices/quick, the 3-field express form
       that already covers the brand-new-user activation path. Sits above
       the existing action bar so the next-real-action signal wins the
       visual hierarchy. print:hidden so a user who prints the sample for
       reference doesn't ship the banner with the artifact. -->
  <% if (invoice.is_seed) { %>
    <div
      data-testid="seed-invoice-view-banner"
      class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 flex flex-wrap items-center gap-4 print:hidden"
      role="region"
      aria-label="This is a sample invoice"
    >
      <div class="flex-1 min-w-0">
        <p class="text-base font-semibold text-amber-900">
          👋 This is the sample invoice we made for you.
        </p>
        <p class="text-sm text-amber-800 mt-1">
          Take a look around — then make your real first invoice in 60 seconds.
        </p>
      </div>
      <a
        href="/invoices/quick"
        data-testid="seed-invoice-view-banner-cta"
        class="bg-brand-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-700 transition whitespace-nowrap"
      >
        📝 Create your real first invoice →
      </a>
    </div>
  <% } %>

  <!-- Action bar -->
  <div class="flex flex-wrap gap-3 mb-8">
    <% if (invoice.status === 'draft') { %>
      <!-- Draft: the next-action CTA is "Mark as Sent" (Pro users also email the client + create a Stripe Payment Link). Print/Download is demoted to secondary so the lifecycle CTA wins the visual hierarchy. -->
      <form action="/invoices/<%= invoice.id %>/status" method="POST" class="inline">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <input type="hidden" name="status" value="sent">
        <button class="bg-brand-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-700 transition flex items-center gap-2">
          📤 Mark as Sent
        </button>
      </form>
      <a href="/invoices/<%= invoice.id %>/print" target="_blank"
        class="border border-gray-300 text-gray-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-50 transition">
        📄 View / Download PDF
      </a>
    <% } else { %>
      <a href="/invoices/<%= invoice.id %>/print" target="_blank"
        class="bg-brand-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-700 transition flex items-center gap-2">
        📄 View / Download PDF
      </a>
    <% } %>
    <a href="/invoices/<%= invoice.id %>/edit"
      class="border border-gray-300 text-gray-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-50 transition">
      ✏️ Edit
    </a>
    <form action="/invoices/<%= invoice.id %>/duplicate" method="POST" class="inline" data-testid="invoice-duplicate-form">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <button type="submit"
        data-testid="invoice-duplicate-button"
        class="border border-gray-300 text-gray-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-50 transition"
        title="<%= invoice.is_seed ? 'Use this sample as a starting point — items and notes copy across, you just swap the client.' : 'Reuse this invoice for the same client or a similar job — starts a fresh draft with the items already filled in.' %>">
        🗐 Duplicate<% if (invoice.is_seed) { %> as draft<% } %>
      </button>
    </form>
    <form action="/invoices/<%= invoice.id %>/duplicate" method="POST" class="inline" data-testid="invoice-duplicate-new-client-form">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <input type="hidden" name="client_scope" value="new_client">
      <button type="submit"
        data-testid="invoice-duplicate-new-client-button"
        class="border border-gray-300 text-gray-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-50 transition"
        title="Reuse the items and notes for a different client — starts a fresh draft with the client fields blank so you don't have to erase the old client first.">
        👤 Duplicate for a new client
      </button>
    </form>
    <% if (invoice.status !== 'paid') { %>
      <form action="/invoices/<%= invoice.id %>/status" method="POST" class="inline">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <input type="hidden" name="status" value="paid">
        <% if (invoice.status === 'sent' || invoice.status === 'overdue') { %>
          <button class="bg-green-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-green-700 transition flex items-center gap-2">
            ✅ Mark as Paid
          </button>
        <% } else { %>
          <button class="border border-green-300 text-green-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-green-50 transition">
            ✅ Mark as Paid
          </button>
        <% } %>
      </form>
    <% } %>
    <form action="/invoices/<%= invoice.id %>/delete" method="POST" class="inline"
      onsubmit="return confirm('Delete this invoice? This cannot be undone.')">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <button class="border border-red-200 text-red-600 font-semibold px-5 py-2.5 rounded-lg hover:bg-red-50 transition">
        🗑️ Delete
      </button>
    </form>
  </div>

  <!-- Draft "send now" banner. Renders only for status='draft' invoices with a
       prefetched share surface — surfaces WhatsApp / SMS / Email / Copy share
       intents above the invoice preview card so the unmistakable next action
       after creating an invoice (sending it to the client) is one tap away,
       not a scroll-and-hunt below the invoice preview. Server-rendered hrefs
       so the buttons work without JS; the onclick handler additionally fires
       POST /share-intent so the draft auto-flips to 'sent' regardless of
       which channel the user picked (mirrors the existing public-share
       section's fireIntent path). Advances Milestone 3 — first invoice
       created → first invoice sent — for the brand-new-user cohort landing
       here from /invoices/quick. -->
  <% if (invoice.status === 'draft' && locals.prefetchedShare && prefetchedShare.shareIntents) { %>
    <%
      const _bannerIntents = prefetchedShare.shareIntents;
      const _bannerShareUrl = prefetchedShare.url || '';
      const _bannerClient = invoice.client_name ? String(invoice.client_name).trim() : '';
      const _bannerEmailClient = (user.plan === 'pro' || user.plan === 'agency') && invoice.client_email
        ? String(invoice.client_email).trim() : '';
    %>
    <div
      data-testid="draft-send-banner"
      class="mb-6 rounded-2xl border border-brand-200 bg-brand-50 px-5 py-5 print:hidden"
      role="region"
      aria-label="Send this invoice to your client"
      x-data="{ emailSending: false, emailSent: false, emailError: '', nativeShareSupported: false, emailSendTo(addr) { try { this.emailSending = true; this.emailError = ''; fetch('/invoices/<%= invoice.id %>/email-client', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.json().then(d => ({ ok: r.ok, status: r.status, data: d }))).then(res => { if (res.ok && res.data && res.data.ok) { this.emailSending = false; this.emailSent = true; setTimeout(() => { try { window.location.reload(); } catch (e) {} }, 1200); } else { this.emailSending = false; this.emailError = (res.data && res.data.error) || 'send_failed'; } }).catch(() => { this.emailSending = false; this.emailError = 'network_error'; }); } catch (e) { this.emailSending = false; this.emailError = 'js_error'; } } }"
      x-init="try { if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') { nativeShareSupported = true; } } catch (e) {}"
    >
      <p class="text-base font-semibold text-gray-800">
        📤 Ready to send<% if (_bannerClient) { %> to <%= _bannerClient %><% } %>?
      </p>
      <p class="text-sm text-gray-600 mt-1 mb-3">
        Tap a channel — we&rsquo;ll mark this invoice as Sent automatically.
      </p>
      <% if (_bannerEmailClient) { %>
        <div class="mb-3" data-testid="draft-send-banner-direct-email-row">
          <button type="button"
            data-testid="draft-send-banner-direct-email"
            x-bind:disabled="emailSending || emailSent"
            @click="emailSendTo('<%= _bannerEmailClient %>')"
            class="inline-flex items-center gap-2 bg-brand-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 disabled:opacity-60 disabled:cursor-not-allowed transition text-sm">
            <span aria-hidden="true">📧</span>
            <span x-show="!emailSending && !emailSent">Send by email to <%= _bannerEmailClient %></span>
            <span x-show="emailSending" x-cloak>Sending…</span>
            <span x-show="emailSent" x-cloak>✓ Sent to <%= _bannerEmailClient %></span>
          </button>
          <p x-show="emailError" x-cloak x-text="emailError === 'no_client_email' ? 'Add a client email on this invoice first.' : emailError === 'not_configured' ? 'Email delivery is not configured yet — use another channel below.' : 'Could not send — try another channel below.'"
            data-testid="draft-send-banner-direct-email-error"
            class="text-red-600 text-xs mt-2"></p>
          <p class="text-xs text-gray-500 mt-1">One tap — we deliver the invoice to your client&rsquo;s inbox and mark it Sent.</p>
        </div>
      <% } %>
      <div class="flex flex-wrap gap-2">
        <a href="<%= _bannerIntents.whatsapp %>"
          target="_blank" rel="noopener"
          data-share="whatsapp"
          data-testid="draft-send-banner-whatsapp"
          onclick="try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'whatsapp' }) }).catch(function(){}); } catch (e) {}"
          class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 hover:border-green-300 transition text-sm">
          <span aria-hidden="true">💬</span><span>WhatsApp</span>
        </a>
        <a href="<%= _bannerIntents.sms %>"
          data-share="sms"
          data-testid="draft-send-banner-sms"
          onclick="try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'sms' }) }).catch(function(){}); } catch (e) {}"
          class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition text-sm">
          <span aria-hidden="true">📱</span><span>SMS</span>
        </a>
        <a href="<%= _bannerIntents.mailto %>"
          data-share="email"
          data-testid="draft-send-banner-email"
          onclick="try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'email' }) }).catch(function(){}); } catch (e) {}"
          class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-indigo-50 hover:border-indigo-300 transition text-sm">
          <span aria-hidden="true">✉️</span><span>Email</span>
        </a>
        <% if (_bannerShareUrl) { %>
          <button type="button"
            data-share="copy"
            data-testid="draft-send-banner-copy"
            data-share-url="<%= _bannerShareUrl %>"
            onclick="(function(btn){ try { var u = btn.getAttribute('data-share-url') || ''; fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'copy' }) }).catch(function(){}); if (u && typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') { navigator.clipboard.writeText(u).then(function(){ var prev = btn.innerHTML; btn.innerHTML = '<span>Copied!</span>'; setTimeout(function(){ btn.innerHTML = prev; }, 2000); }).catch(function(){}); } } catch (e) {} })(this)"
            class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-100 transition text-sm">
            <span aria-hidden="true">🔗</span><span>Copy link</span>
          </button>
        <% } %>
        <button type="button"
          data-share="native"
          data-testid="draft-send-banner-native"
          x-show="nativeShareSupported"
          x-cloak
          @click="try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'native' }) }).catch(function(){}); navigator.share({ title: <%= JSON.stringify(_bannerIntents.subject || '') %>, text: <%= JSON.stringify(_bannerIntents.body || '') %>, url: <%= JSON.stringify(_bannerShareUrl || '') %> }).catch(function(){}); } catch (e) {}"
          class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-100 transition text-sm">
          <span aria-hidden="true">📱</span><span>More apps&hellip;</span>
        </button>
      </div>
      <% if (user && user.email) { %>
        <div class="mt-4 pt-3 border-t border-brand-100"
          data-testid="draft-send-banner-self-test"
          x-data="{ selfSending: false, selfSent: false, selfError: '', selfSendTest() { try { this.selfSending = true; this.selfError = ''; fetch('/invoices/<%= invoice.id %>/email-self', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.json().then(d => ({ ok: r.ok, status: r.status, data: d }))).then(res => { if (res.ok && res.data && res.data.ok) { this.selfSending = false; this.selfSent = true; } else { this.selfSending = false; this.selfError = (res.data && res.data.error) || 'send_failed'; } }).catch(() => { this.selfSending = false; this.selfError = 'network_error'; }); } catch (e) { this.selfSending = false; this.selfError = 'js_error'; } } }">
          <p class="text-xs text-gray-600 mb-2">Not sure how it&rsquo;ll look in their inbox? See it in yours first &mdash; no email is sent to the client.</p>
          <button type="button"
            data-testid="draft-send-banner-self-test-button"
            x-bind:disabled="selfSending || selfSent"
            @click="selfSendTest()"
            class="inline-flex items-center gap-2 bg-white border border-brand-200 text-brand-700 font-semibold px-4 py-2 rounded-lg hover:bg-brand-50 disabled:opacity-60 disabled:cursor-not-allowed transition text-sm">
            <span aria-hidden="true">📨</span>
            <span x-show="!selfSending && !selfSent">Send a test to <%= user.email %></span>
            <span x-show="selfSending" x-cloak>Sending test&hellip;</span>
            <span x-show="selfSent" x-cloak>&#10003; Test sent &mdash; check <%= user.email %></span>
          </button>
          <p x-show="selfError" x-cloak
            x-text="selfError === 'not_configured' ? 'Email delivery is not configured yet — try again later.' : selfError === 'no_owner_email' ? 'No email on file — add one in Account settings.' : 'Could not send the test — please try again.'"
            data-testid="draft-send-banner-self-test-error"
            class="text-red-600 text-xs mt-2"></p>
        </div>
      <% } %>
      <p class="text-xs text-gray-500 mt-3 flex flex-wrap gap-x-4 gap-y-1">
        <a href="/invoices/<%= invoice.id %>/preview-email" target="_blank" rel="noopener"
          class="underline hover:text-brand-700" data-testid="draft-send-banner-preview-email">
          👀 Preview the email
        </a>
        <a href="/invoices/<%= invoice.id %>/preview-public" target="_blank" rel="noopener"
          class="underline hover:text-brand-700" data-testid="draft-send-banner-preview-public">
          🖥️ Preview the share page
        </a>
        <a href="#public-share-section" class="underline hover:text-brand-700" data-testid="draft-send-banner-more">↓ More share options</a>
      </p>
    </div>
  <% } %>

  <!-- Inline "How to pay" capture (Milestone 4 — first invoice sent → first
       payment received). Free-tier users have no Stripe Pay button, so the
       public /i/<token> share page their client opens shows the invoice but
       no payment path unless they've filled in users.payment_instructions
       via /billing/settings — most don't. This block surfaces a one-field
       capture at the share moment, on every draft/sent/overdue invoice
       view, until the user fills it in. Once saved it vanishes everywhere
       and the instructions render on every share link the user owns
       (already wired in views/invoice-public.ejs). -->
  <% if (user && user.plan === 'free' && !user.payment_instructions && invoice.status !== 'paid') { %>
    <form action="/billing/payment-instructions" method="POST"
      data-testid="inline-payment-instructions-prompt"
      class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-5 print:hidden">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <input type="hidden" name="return_to" value="/invoices/<%= invoice.id %>" data-testid="inline-payment-instructions-return-to">
      <p class="text-base font-semibold text-amber-900">
        💰 Tell your client how to pay you
      </p>
      <p class="text-sm text-amber-800 mt-1">
        On the free plan your share link has no Pay button — give your client a way to actually send the money. Venmo, Zelle, bank transfer, cheque, anything.
      </p>
      <textarea name="payment_instructions" rows="3" maxlength="2000" required
        data-testid="inline-payment-instructions-input"
        placeholder="Venmo @yourhandle&#10;Zelle: you@bank.com&#10;Bank: Chase, routing 021000021, acct 1234567890"
        class="w-full mt-3 border border-amber-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="submit"
          data-testid="inline-payment-instructions-submit"
          class="bg-amber-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-amber-700 transition text-sm">
          Save payment instructions
        </button>
        <p class="text-xs text-amber-700">Shows on every invoice your client opens via a share link.</p>
      </div>
    </form>
  <% } %>

  <!-- Invoice preview card -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 md:p-12">
    <!-- Header -->
    <div class="flex justify-between items-start mb-10">
      <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= user.business_name || user.name || 'Your Business' %></h2>
        <% if (user.business_address) { %>
          <p class="text-gray-400 text-sm mt-1 whitespace-pre-line"><%= user.business_address %></p>
        <% } %>
        <% if (user.business_email || user.email) { %>
          <p class="text-gray-400 text-sm"><%= user.business_email || user.email %></p>
        <% } %>
        <% if (user.business_phone) { %>
          <p class="text-gray-400 text-sm"><%= user.business_phone %></p>
        <% } %>
      </div>
      <div class="text-right">
        <div class="text-3xl font-extrabold text-brand-600">INVOICE</div>
        <div class="text-gray-500 text-sm mt-1">#<%= invoice.invoice_number %></div>
      </div>
    </div>

    <!-- Invoice meta + Bill To -->
    <div class="grid md:grid-cols-2 gap-8 mb-10">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Bill To</p>
        <p class="font-semibold text-gray-800"><%= invoice.client_name %></p>
        <% if (invoice.client_email) { %><p class="text-gray-500 text-sm"><%= invoice.client_email %></p><% } %>
        <% if (invoice.client_address) { %><p class="text-gray-500 text-sm whitespace-pre-line"><%= invoice.client_address %></p><% } %>
      </div>
      <div class="text-right">
        <div class="space-y-1 text-sm">
          <div class="flex justify-end gap-8">
            <span class="text-gray-400">Issue Date</span>
            <span class="font-medium text-gray-700"><%= new Date(invoice.issued_date).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) %></span>
          </div>
          <% if (invoice.due_date) { %>
          <div class="flex justify-end gap-8">
            <span class="text-gray-400">Due Date</span>
            <span class="font-medium text-gray-700"><%= new Date(invoice.due_date).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) %></span>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Line items -->
    <table class="w-full text-sm mb-6">
      <thead>
        <tr class="border-b-2 border-gray-200">
          <th class="text-left py-2 text-gray-500 font-semibold">Description</th>
          <th class="text-center py-2 text-gray-500 font-semibold w-20">Qty</th>
          <th class="text-right py-2 text-gray-500 font-semibold w-28">Unit Price</th>
          <th class="text-right py-2 text-gray-500 font-semibold w-28">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% (invoice.items || []).forEach(item => { %>
          <tr class="border-b border-gray-100">
            <td class="py-3 text-gray-700"><%= item.description %></td>
            <td class="py-3 text-center text-gray-500"><%= item.quantity %></td>
            <td class="py-3 text-right text-gray-500"><%= _viewFmt(item.unit_price, _viewCcy) %></td>
            <td class="py-3 text-right font-medium text-gray-800"><%= _viewFmt(item.quantity * item.unit_price, _viewCcy) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Totals -->
    <div class="flex justify-end mb-8">
      <div class="w-64 space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Subtotal</span>
          <span class="font-medium" data-testid="invoice-view-subtotal"><%= _viewFmt(invoice.subtotal, _viewCcy) %></span>
        </div>
        <% if (parseFloat(invoice.tax_rate) > 0) { %>
          <div class="flex justify-between">
            <span class="text-gray-500">Tax (<%= invoice.tax_rate %>%)</span>
            <span class="font-medium" data-testid="invoice-view-tax"><%= _viewFmt(invoice.tax_amount, _viewCcy) %></span>
          </div>
        <% } %>
        <div class="flex justify-between border-t border-gray-200 pt-2">
          <span class="font-bold text-gray-800">Total</span>
          <span class="font-bold text-xl text-gray-900" data-testid="invoice-view-total"><%= _viewFmt(invoice.total, _viewCcy) %></span>
        </div>
      </div>
    </div>

    <!-- Free-plan dead-end recovery (#15). When the invoice has no payment
         link AND the owner is on free, surface a canonical pro-lock card so
         the user can see + click into the paid feature instead of staring
         at a printable PDF and wondering why "Mark as Sent" did nothing.
         Pro/Agency users with payment_link_url fall through to the live UI
         a few lines below; Pro users without a link (e.g. status=draft)
         silently skip this whole section. -->
    <% if (!invoice.payment_link_url && user.plan === 'free') { %>
      <div class="border-t border-gray-100 pt-6 mb-6 space-y-3">
        <%- include('partials/pro-lock', { proLock: {
          feature: 'payment_link',
          icon: '💳',
          headline: 'Add a one-click Stripe pay button to this invoice',
          benefit: 'Pro auto-creates a secure Stripe payment link on every invoice — clients pay by card, ACH, or bank in one click instead of mailing a check.'
        } }) %>
        <%- include('partials/pro-lock', { proLock: {
          feature: 'email_send',
          icon: '✉️',
          headline: 'Email this invoice to the client automatically',
          benefit: 'On Pro, "Mark as Sent" emails the invoice straight to the client with the pay link attached — no copy-paste, no forgotten attachments.'
        } }) %>
      </div>
    <% } %>

    <!-- Public share link (#43). Tokenized /i/<token> URL the freelancer
         can paste into a DM, email, or text so the client views the invoice
         in their browser — no DecentInvoice account required. Open to every
         plan: it's the activation funnel's only in-app way for a free user
         to deliver an invoice. The token is eagerly minted server-side in
         GET /invoices/:id (Milestone 3) and the surface is prefilled below
         via data-prefetch-* attributes — Alpine reads them in x-init so the
         share-intent buttons render on first paint, no Generate click. The
         Generate button stays in the DOM as a fallback in case the prefetch
         fails (rare) or the page is rendered without the prefetched share.
         Free users see a tailored sub-line about the missing pay button so
         the Pro upgrade pressure rides every share. -->
    <% const _shareIsPaidOwner = user.plan === 'pro' || user.plan === 'agency'; %>
    <%
      const _prefShare = (locals.prefetchedShare && typeof locals.prefetchedShare === 'object'
        && locals.prefetchedShare.url) ? locals.prefetchedShare : null;
      const _prefUrl = _prefShare ? _prefShare.url : '';
      const _prefIntentsJson = (_prefShare && _prefShare.shareIntents)
        ? JSON.stringify(_prefShare.shareIntents) : '';
      const _prefFollowUpJson = (_prefShare && _prefShare.followUpIntents)
        ? JSON.stringify(_prefShare.followUpIntents) : '';
    %>
      <div class="border-t border-gray-100 pt-6 mb-6 scroll-mt-6"
        id="public-share-section"
        data-testid="public-share-section"
        data-owner-plan="<%= _shareIsPaidOwner ? 'paid' : 'free' %>"
        data-prefetch-url="<%= _prefUrl %>"
        data-prefetch-intents="<%= _prefIntentsJson %>"
        data-prefetch-followup="<%= _prefFollowUpJson %>"
        x-data="{ url: '', copied: false, loading: false, error: '', intents: null, followUpIntents: null, nativeShareSupported: false, emailSending: false, emailSent: false, emailError: '', qrOpen: false, qrRendered: false, qrError: '', fireIntent(kind) { try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: kind }) }).catch(() => {}); } catch (e) {} }, nativeShare(data) { try { if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') { navigator.share(data).catch(() => {}); } } catch (e) {} }, emailSendDirect() { try { this.emailSending = true; this.emailError = ''; fetch('/invoices/<%= invoice.id %>/email-client', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.json().then(d => ({ ok: r.ok, status: r.status, data: d }))).then(res => { if (res.ok && res.data && res.data.ok) { this.emailSending = false; this.emailSent = true; setTimeout(() => { try { window.location.reload(); } catch (e) {} }, 1200); } else { this.emailSending = false; this.emailError = (res.data && res.data.error) || 'send_failed'; } }).catch(() => { this.emailSending = false; this.emailError = 'network_error'; }); } catch (e) { this.emailSending = false; this.emailError = 'js_error'; } }, revealQr() { if (this.qrOpen) { this.qrOpen = false; return; } if (!this.url) { this.qrError = 'no_url'; return; } this.qrOpen = true; if (this.qrRendered) return; try { this.fireIntent('qr'); } catch (e) {} var self = this; var paint = function () { try { var el = document.getElementById('owner-share-qr-<%= invoice.id %>'); if (!el || typeof window.QRCode === 'undefined' || !self.url) { self.qrError = 'qr_unavailable'; return; } window.QRCode.toString(self.url, { type: 'svg', margin: 1, width: 200 }, function (err, svg) { if (err || !svg) { self.qrError = 'qr_render_failed'; return; } el.innerHTML = svg; self.qrRendered = true; self.qrError = ''; }); } catch (e) { self.qrError = 'qr_render_failed'; } }; if (typeof window.QRCode !== 'undefined') { paint(); return; } var s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js'; s.async = true; s.onload = paint; s.onerror = function () { self.qrError = 'qr_script_load_failed'; }; document.head.appendChild(s); } }"
        x-init="try { if ($el.dataset.prefetchUrl) { url = $el.dataset.prefetchUrl; } if ($el.dataset.prefetchIntents) { intents = JSON.parse($el.dataset.prefetchIntents); } if ($el.dataset.prefetchFollowup) { followUpIntents = JSON.parse($el.dataset.prefetchFollowup); } if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') { nativeShareSupported = true; } } catch (e) {}">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Public share link</p>
        <% if (_shareIsPaidOwner) { %>
          <p class="text-gray-500 text-sm mb-3">Send your client a tokenized URL that opens this invoice in their browser — no login required. They see your branding and the pay button.</p>
        <% } else { %>
          <p class="text-gray-500 text-sm mb-3">Send your client a tokenized URL that opens this invoice in their browser — no login required. They see your branding and the totals.</p>
          <div class="bg-brand-50 border border-brand-200 rounded-lg px-4 py-3 mb-3 flex items-start gap-3" data-testid="public-share-free-nudge">
            <span class="text-lg leading-none" aria-hidden="true">💳</span>
            <div class="flex-1 text-sm text-gray-700">
              <p>Your client will see the invoice <strong>without a Pay button</strong> — they'll have to pay you by check, Venmo, or bank transfer.</p>
              <form action="/billing/create-checkout" method="POST" class="inline-flex items-center gap-2 mt-2" data-pro-lock-form>
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="billing_cycle" value="annual">
                <input type="hidden" name="source" value="share-link-pay-nudge">
                <button type="submit" class="text-brand-700 font-semibold text-sm hover:underline">
                  Add a Stripe Pay button on Pro &rarr;
                </button>
              </form>
            </div>
          </div>
        <% } %>
        <div class="flex items-center gap-2" x-show="!url">
          <button type="button"
            data-testid="public-share-generate"
            @click="loading = true; error = ''; fetch('/invoices/<%= invoice.id %>/share', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.ok ? r.json() : Promise.reject(new Error('http_' + r.status))).then(data => { url = data.url || ''; intents = data.shareIntents || null; followUpIntents = data.followUpIntents || null; loading = false; }).catch(e => { error = 'Could not generate link — try again.'; loading = false; })"
            class="bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 transition disabled:opacity-50"
            :disabled="loading">
            <span x-show="!loading">🔗 Generate share link</span>
            <span x-show="loading">Generating…</span>
          </button>
        </div>
        <div x-show="url" x-cloak class="flex items-center gap-2">
          <input type="text" readonly x-bind:value="url"
            data-testid="public-share-url"
            class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 bg-gray-50 font-mono" />
          <button type="button"
            data-testid="public-share-copy"
            data-share-intent="copy"
            @click="fireIntent('copy'); navigator.clipboard.writeText(url).then(() => { copied = true; setTimeout(() => copied = false, 2000); })"
            class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm">
            <span x-show="!copied">Copy</span>
            <span x-show="copied" class="text-green-600">Copied!</span>
          </button>
          <a x-bind:href="url" target="_blank" rel="noopener"
            title="Open the client view in a new tab"
            class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm whitespace-nowrap">
            Preview ↗
          </a>
        </div>
        <p x-show="error" x-text="error" class="text-red-600 text-xs mt-2"></p>
        <!-- Share-intent buttons: collapse the "now I have the URL, open
             WhatsApp, paste, type something" step into one tap. Hrefs are
             server-computed in POST /invoices/:id/share so encoding +
             body text stay a single source of truth with the Pro pay-link
             intents. Rendered when the fetch returns intents (free + Pro). -->
        <div x-show="url && intents" x-cloak class="mt-4 pt-4 border-t border-gray-100"
          data-testid="public-share-intents">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Send to client</p>
          <% if (_shareIsPaidOwner && invoice.client_email) { %>
            <div class="mb-3" data-testid="public-share-direct-email-row">
              <button type="button"
                data-testid="public-share-direct-email"
                x-bind:disabled="emailSending || emailSent"
                @click="emailSendDirect()"
                title="Send the invoice directly to your client's inbox from DecentInvoice — no mailto: roundtrip"
                class="inline-flex items-center gap-2 bg-brand-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 disabled:opacity-60 disabled:cursor-not-allowed transition text-sm">
                <span aria-hidden="true">📧</span>
                <span x-show="!emailSending && !emailSent">Send by email to <%= invoice.client_email %></span>
                <span x-show="emailSending" x-cloak>Sending…</span>
                <span x-show="emailSent" x-cloak>✓ Sent to <%= invoice.client_email %></span>
              </button>
              <p x-show="emailError" x-cloak x-text="emailError === 'no_client_email' ? 'Add a client email on this invoice first.' : emailError === 'not_configured' ? 'Email delivery is not configured yet — use another channel below.' : 'Could not send — try another channel below.'"
                data-testid="public-share-direct-email-error"
                class="text-red-600 text-xs mt-2"></p>
              <p class="text-xs text-gray-500 mt-1">One tap — we deliver the invoice straight to your client and mark it Sent.</p>
            </div>
          <% } %>
          <div class="flex flex-wrap gap-2">
            <a x-bind:href="intents && intents.whatsapp" target="_blank" rel="noopener"
              data-share="whatsapp"
              @click="fireIntent('whatsapp')"
              title="Open WhatsApp with a prefilled message"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 hover:border-green-300 transition text-sm">
              <span aria-hidden="true">💬</span>
              <span>WhatsApp</span>
            </a>
            <a x-bind:href="intents && intents.sms"
              data-share="sms"
              @click="fireIntent('sms')"
              title="Open Messages with a prefilled SMS"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition text-sm">
              <span aria-hidden="true">📱</span>
              <span>SMS</span>
            </a>
            <a x-bind:href="intents && intents.mailto"
              data-share="email"
              @click="fireIntent('email')"
              title="Open your email client with a prefilled message"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-indigo-50 hover:border-indigo-300 transition text-sm">
              <span aria-hidden="true">✉️</span>
              <span>Email</span>
            </a>
            <button type="button"
              x-show="nativeShareSupported"
              x-cloak
              data-share="native"
              data-testid="public-share-native"
              @click="fireIntent('native'); nativeShare({ title: (intents && intents.subject) || '', text: (intents && intents.body) || '', url: url })"
              title="Open your device's share menu — pick Telegram, Signal, Slack, Messenger, and more"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-purple-50 hover:border-purple-300 transition text-sm">
              <span aria-hidden="true">📤</span>
              <span>Share via…</span>
            </button>
          </div>
          <p class="text-gray-400 text-xs mt-2">Each button opens your native app with the message prefilled — review and hit send.</p>
        </div>
        <!-- QR code for in-person handoff (Milestone 3 — created → sent;
             Milestone 4 — sent → paid). Mobile-service freelancers
             (trainers, hairdressers, contractors, tutors, mobile repair) need
             a scannable share path at the end of a session — typing a URL or
             a Venmo handle into the client's phone is the friction point.
             Toggle is lazy: the qrcode.js CDN script is only loaded after the
             first reveal, so the freelancer pays zero load tax for the panel
             until they actually use it. On first reveal we fire share-intent
             ='qr' so the draft → sent auto-flip and the activation funnel's
             intent counters both pick up the QR cohort. Visible on every plan
             — the QR points at the same /i/<token> public share page that
             already exists. -->
        <div x-show="url" x-cloak class="mt-4 pt-4 border-t border-gray-100"
          data-testid="public-share-qr">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">In-person handoff</p>
          <p class="text-gray-500 text-xs mb-3">Working face-to-face? Show this QR code on your phone and have your client scan it with their camera to open the invoice — no typing, no app install.</p>
          <button type="button"
            data-testid="public-share-qr-toggle"
            @click="revealQr()"
            class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm">
            <span aria-hidden="true">🔳</span>
            <span x-show="!qrOpen">Show QR code</span>
            <span x-show="qrOpen" x-cloak>Hide QR code</span>
          </button>
          <div x-show="qrOpen" x-cloak class="mt-4"
            data-testid="public-share-qr-panel">
            <div class="inline-flex flex-col items-center gap-2 p-4 rounded-lg border border-gray-200 bg-white">
              <div id="owner-share-qr-<%= invoice.id %>"
                data-testid="public-share-qr-image"
                class="w-[200px] h-[200px] flex items-center justify-center text-gray-300 text-xs"
                aria-label="QR code that opens the public invoice link">
                Loading…
              </div>
              <p x-show="qrError" x-cloak data-testid="public-share-qr-error"
                class="text-red-600 text-xs max-w-[220px] text-center">
                Could not load the QR — copy the link above instead.
              </p>
              <p class="text-gray-500 text-xs max-w-[220px] text-center">
                Scan with the camera app to open <span class="font-mono text-gray-700 break-all" x-text="url"></span>
              </p>
            </div>
          </div>
        </div>
        <!-- Follow-up share intents (Milestone 4 — sent → paid). Visible
             only when the invoice has been sent (status='sent' or 'overdue')
             AND the user has just generated / opened the share link in this
             page load. The buttons pre-fill a softer "just checking in"
             message instead of the original "here's invoice X" copy, so
             the freelancer has a one-tap nudge path for clients who saw
             the first message but haven't paid yet. Click is tracked via
             the existing /share-intent endpoint — repeat clicks are
             idempotent (the route does its own atomic guard). -->
        <% const _isSentOrOverdue = invoice.status === 'sent' || invoice.status === 'overdue'; %>
        <% if (_isSentOrOverdue) { %>
          <div x-show="url && followUpIntents" x-cloak class="mt-4 pt-4 border-t border-gray-100"
            data-testid="public-share-followup">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Send a follow-up</p>
            <p class="text-gray-500 text-xs mb-3">Already sent it? Tap to nudge — the message says "just checking in" instead of resending the invoice cold.</p>
            <div class="flex flex-wrap gap-2">
              <a x-bind:href="followUpIntents && followUpIntents.whatsapp" target="_blank" rel="noopener"
                data-share="followup-whatsapp"
                @click="fireIntent('whatsapp')"
                title="Open WhatsApp with a follow-up message"
                class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 hover:border-green-300 transition text-sm">
                <span aria-hidden="true">💬</span>
                <span>WhatsApp follow-up</span>
              </a>
              <a x-bind:href="followUpIntents && followUpIntents.sms"
                data-share="followup-sms"
                @click="fireIntent('sms')"
                title="Open Messages with a follow-up SMS"
                class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition text-sm">
                <span aria-hidden="true">📱</span>
                <span>SMS follow-up</span>
              </a>
              <a x-bind:href="followUpIntents && followUpIntents.mailto"
                data-share="followup-email"
                @click="fireIntent('email')"
                title="Open your email client with a follow-up message"
                class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-indigo-50 hover:border-indigo-300 transition text-sm">
                <span aria-hidden="true">✉️</span>
                <span>Email follow-up</span>
              </a>
            </div>
            <p x-show="followUpIntents && followUpIntents.overdue" x-cloak
              data-testid="public-share-followup-overdue"
              class="mt-2 text-xs text-amber-700">
              This invoice is past its due date — the message also flags it as overdue.
            </p>
          </div>
        <% } %>
        <p class="text-gray-400 text-xs mt-2">Anyone with this link can view this invoice — share it only with your client.</p>
      </div>

    <!-- Payment Link (Pro) -->
    <% if (invoice.payment_link_url && user.plan === 'pro') { %>
      <%
        const methods = (typeof paymentMethods !== 'undefined' && Array.isArray(paymentMethods)) ? paymentMethods : ['card'];
        const labelFor = { card: 'card', us_bank_account: 'US bank transfer (ACH)', sepa_debit: 'SEPA Direct Debit', au_becs_debit: 'BECS Direct Debit', bacs_debit: 'BACS Direct Debit', acss_debit: 'Pre-authorised debit', link: 'Stripe Link' };
        const labels = methods.map(m => labelFor[m] || m);
        const methodCopy = labels.length === 1
          ? labels[0]
          : labels.slice(0, -1).join(', ') + ' or ' + labels[labels.length - 1];
        // Share-intent prefill (#92). Native compose targets:
        //   wa.me   → WhatsApp web/app, single `text` query param
        //   sms:    → iOS/Android Messages, `body` after `?` (RFC 5724)
        //   mailto: → Mail.app/Gmail/Outlook, `subject` + `body`
        // Body kept short to fit SMS 160-char window with the URL itself; URL
        // is appended last so even truncated previews preserve the click target.
        const shareGreeting = invoice.client_name ? ('Hi ' + invoice.client_name + ',') : 'Hi,';
        const shareTotal = '$' + parseFloat(invoice.total).toFixed(2);
        const shareBody = shareGreeting + ' here\'s invoice ' + invoice.invoice_number +
          ' for ' + shareTotal + '. You can pay securely here: ' + invoice.payment_link_url;
        const shareSubject = 'Invoice ' + invoice.invoice_number + ' — ' + shareTotal;
        const waHref = 'https://wa.me/?text=' + encodeURIComponent(shareBody);
        const smsHref = 'sms:?&body=' + encodeURIComponent(shareBody);
        // Defence in depth: percent-encode the recipient so a malformed
        // client_email (e.g. one containing `?` or `&`) cannot inject extra
        // mailto: query params. Modern mail clients un-encode `%40` back to
        // `@` correctly; the alternative — passing the raw email — would
        // allow `foo@bar.com?cc=attacker%40evil.com` to silently CC a third
        // party from the user's mail client.
        const mailHref = 'mailto:' + encodeURIComponent(invoice.client_email || '') +
          '?subject=' + encodeURIComponent(shareSubject) +
          '&body=' + encodeURIComponent(shareBody);
      %>
      <div class="border-t border-gray-100 pt-6 mb-6"
        x-data="{ copied: false, nativeShareSupported: false, fireIntent(kind) { try { fetch('/invoices/<%= invoice.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: kind }) }).catch(() => {}); } catch (e) {} }, nativeShare(data) { try { if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') { navigator.share(data).catch(() => {}); } } catch (e) {} } }"
        x-init="try { if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') { nativeShareSupported = true; } } catch (e) {}">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Payment Link</p>
        <p class="text-gray-500 text-sm mb-1">Send this secure Stripe link to your client so they can pay in one click.</p>
        <p class="text-gray-400 text-xs mb-3">Clients can pay via <%= methodCopy %>.</p>
        <div class="flex items-center gap-2">
          <input type="text" readonly value="<%= invoice.payment_link_url %>"
            data-pay-link-url="<%= invoice.payment_link_url %>"
            class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 bg-gray-50 font-mono" />
          <button type="button"
            data-share-intent="copy"
            @click="fireIntent('copy'); navigator.clipboard.writeText($root.querySelector('[data-pay-link-url]').dataset.payLinkUrl).then(() => { copied = true; setTimeout(() => copied = false, 2000); })"
            class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm">
            <span x-show="!copied">Copy</span>
            <span x-show="copied" class="text-green-600">Copied!</span>
          </button>
          <a href="<%= invoice.payment_link_url %>" target="_blank" rel="noopener"
            title="Open the Stripe payment page your client will see"
            class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm whitespace-nowrap">
            Preview ↗
          </a>
        </div>
        <p class="text-gray-400 text-xs mt-2">Preview opens the page your client sees.</p>

        <!-- Share to client (#92) — WhatsApp / SMS / Email open the user's
             native compose window with the pay link prefilled. No data leaves
             the browser; clicking just calls the OS's URL handler. -->
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Send to client</p>
          <div class="flex flex-wrap gap-2">
            <a href="<%= waHref %>" target="_blank" rel="noopener"
              data-share="whatsapp"
              @click="fireIntent('whatsapp')"
              title="Open WhatsApp with a prefilled message"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 hover:border-green-300 transition text-sm">
              <span aria-hidden="true">💬</span>
              <span>WhatsApp</span>
            </a>
            <a href="<%= smsHref %>"
              data-share="sms"
              @click="fireIntent('sms')"
              title="Open Messages with a prefilled SMS"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition text-sm">
              <span aria-hidden="true">📱</span>
              <span>SMS</span>
            </a>
            <a href="<%= mailHref %>"
              data-share="email"
              @click="fireIntent('email')"
              title="Open your email client with a prefilled message"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-indigo-50 hover:border-indigo-300 transition text-sm">
              <span aria-hidden="true">✉️</span>
              <span>Email</span>
            </a>
            <button type="button"
              x-show="nativeShareSupported"
              x-cloak
              data-share="native"
              data-testid="pay-link-share-native"
              @click="fireIntent('native'); nativeShare({ title: <%= JSON.stringify(shareSubject) %>, text: <%= JSON.stringify(shareBody) %>, url: <%= JSON.stringify(invoice.payment_link_url) %> })"
              title="Open your device's share menu — pick Telegram, Signal, Slack, Messenger, and more"
              class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-purple-50 hover:border-purple-300 transition text-sm">
              <span aria-hidden="true">📤</span>
              <span>Share via…</span>
            </button>
          </div>
          <p class="text-gray-400 text-xs mt-2">Each button opens your native app with the message prefilled — review and hit send.</p>
        </div>
      </div>
    <% } %>

    <!-- Notes -->
    <% if (invoice.notes) { %>
      <div class="border-t border-gray-100 pt-6">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Notes</p>
        <p class="text-gray-500 text-sm whitespace-pre-line"><%= invoice.notes %></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
