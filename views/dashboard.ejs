        <a href="/invoices/new" data-testid="first-real-invoice-prompt-advanced" class="text-brand-600 underline hover:text-brand-700">Use the advanced form &rarr;</a>
      </p>
      <% if (user && user.plan === 'free') { %>
        <p class="text-xs text-gray-400 mt-6 max-w-sm mx-auto">
          ✨ <strong>Pro adds a "Pay now" button</strong> to every invoice — clients pay in one click via Stripe.
          <a href="/billing/upgrade" class="text-brand-600 underline hover:text-brand-700">Try Pro free for 7 days &rarr;</a>
        </p>
      <% } %>
    </div>
  <% } %>
  <% if (invoices.length === 0 && !firstRealInvoicePrompt) { %>
    <!-- Legacy empty-state fallback (fires only when firstRealInvoicePrompt is null — e.g. error-fallback render with no user) -->
    <div class="bg-white rounded-2xl border border-gray-200 p-16 text-center print:hidden">
      <div class="text-5xl mb-4">📄</div>
      <h2 class="text-lg font-semibold text-gray-700 mb-2">Send your first invoice today</h2>
      <p class="text-gray-400 mb-6 text-sm">A professional invoice in under 60 seconds. Email it, print it as a PDF, or share a Stripe pay link — all from one screen.</p>
      <a href="/invoices/quick" class="bg-brand-600 text-white font-semibold px-6 py-3 rounded-xl hover:bg-brand-700 transition inline-block">
        Create your first invoice &rarr;
      </a>
      <p class="text-xs text-gray-400 mt-3">
        Need line items, tax or custom dates?
        <a href="/invoices/new" class="text-brand-600 underline hover:text-brand-700">Use the advanced form &rarr;</a>
      </p>
      <% if (user && user.plan === 'free') { %>
        <p class="text-xs text-gray-400 mt-6 max-w-sm mx-auto">
          ✨ <strong>Pro adds a "Pay now" button</strong> to every invoice — clients pay in one click via Stripe.
          <a href="/billing/upgrade" class="text-brand-600 underline hover:text-brand-700">Try Pro free for 7 days &rarr;</a>
        </p>
      <% } %>
    </div>
  <% } else if (invoices.length > 0) { %>
    <!-- Stats -->
    <%
      const total = invoices.reduce((s, i) => s + parseFloat(i.total), 0);
      const paid = invoices.filter(i => i.status === 'paid').reduce((s, i) => s + parseFloat(i.total), 0);
      const outstanding = invoices.filter(i => i.status !== 'paid').reduce((s, i) => s + parseFloat(i.total), 0);
    %>
    <% if (locals.recentRevenue && recentRevenue) { %>
      <div
        x-data='recentRevenueCard(<%- JSON.stringify({ days: recentRevenue.days, totalPaid: recentRevenue.totalPaid, invoiceCount: recentRevenue.invoiceCount, clientCount: recentRevenue.clientCount, unpaidCount: recentRevenue.unpaidCount }).replace(/</g, "\\u003c") %>)'
        data-testid="recent-revenue"
        :data-days="days"
        data-days="<%= recentRevenue.days %>"
        class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 print:hidden"
        role="region"
        aria-label="Recent paid revenue"
      >
        <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
          <div>
            <h2 class="text-sm font-semibold text-emerald-900 flex items-center gap-2">
              <span aria-hidden="true">💸</span>
              You've been getting paid
            </h2>
            <p class="text-xs text-emerald-700 mt-0.5">Last <span x-text="days"><%= recentRevenue.days %></span> days</p>
          </div>
          <div
            class="inline-flex items-center bg-white rounded-lg border border-emerald-200 p-0.5 text-xs font-medium"
            role="group"
            aria-label="Choose revenue window"
            data-testid="recent-revenue-toggle"
          >
            <template x-for="opt in [7, 30, 90]" :key="opt">
              <button
                type="button"
                @click="select(opt)"
                :disabled="loading"
                :class="days === opt ? 'bg-emerald-600 text-white' : 'text-emerald-700 hover:bg-emerald-50'"
                class="px-3 py-1 rounded-md transition-colors disabled:opacity-60 disabled:cursor-wait"
                :aria-pressed="days === opt ? 'true' : 'false'"
                x-text="opt + 'd'"
              ></button>
            </template>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3" :class="loading ? 'opacity-60 transition-opacity' : ''">
          <div class="bg-white rounded-xl border border-emerald-100 p-4">
            <p class="text-xs font-medium text-emerald-700 uppercase tracking-wide mb-1">Revenue</p>
            <p class="text-xl font-bold text-emerald-700" data-testid="recent-revenue-total" x-text="formatMoney(totalPaid)">
              $<%= recentRevenue.totalPaid.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
            </p>
          </div>
          <div class="bg-white rounded-xl border border-emerald-100 p-4">
            <p class="text-xs font-medium text-emerald-700 uppercase tracking-wide mb-1">Clients paid you</p>
            <p class="text-xl font-bold text-gray-900" data-testid="recent-revenue-clients" x-text="clientCount">
              <%= recentRevenue.clientCount %>
            </p>
          </div>
          <div class="bg-white rounded-xl border border-emerald-100 p-4">
            <p class="text-xs font-medium text-emerald-700 uppercase tracking-wide mb-1">Invoices paid</p>
            <p class="text-xl font-bold text-gray-900" data-testid="recent-revenue-invoices" x-text="invoiceCount">
              <%= recentRevenue.invoiceCount %>
            </p>
          </div>
        </div>
        <p
          x-show="errored"
          x-cloak
          class="text-xs text-red-700 mt-2"
          role="status"
          data-testid="recent-revenue-error"
        >Couldn't load that window — showing the previous one.</p>
        <p
          x-show="totalPaid === 0 && unpaidCount > 0"
          x-cloak
          class="text-xs text-emerald-800 mt-2"
          role="status"
          aria-live="polite"
          data-testid="recent-revenue-quiet-cta"
        >
          <a
            href="#invoices-table"
            class="inline-flex items-center gap-1 font-medium underline decoration-dotted hover:decoration-solid"
            data-testid="recent-revenue-quiet-cta-link"
          >
            <span aria-hidden="true">📨</span>
            Send <span x-text="unpaidCount"><%= recentRevenue.unpaidCount %></span> follow-up<span x-show="unpaidCount !== 1">s</span> now
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <script>
        // Backs the recent-revenue card window toggle (#117). Initial state
        // comes from the server-rendered card so the page is meaningful
        // before Alpine boots; subsequent toggles fetch JSON and re-render.
        // The fetch is a same-origin authenticated GET; on failure we keep
        // the previous values + flag the small error line.
        //
        // Per-device window preference (#122) is persisted to localStorage
        // under 'qi.recentRevenueDays'. On init we restore the saved window
        // if (a) it parses as a whitelist member [7,30,90] and (b) it
        // differs from the SSR-rendered default — otherwise the SSR render
        // already shows the right thing and we make zero network calls.
        function recentRevenueCard(initial) {
          var STORAGE_KEY = 'qi.recentRevenueDays';
          var ALLOWED = [7, 30, 90];
          function readSavedWindow() {
            try {
              if (typeof localStorage === 'undefined') return null;
              var raw = localStorage.getItem(STORAGE_KEY);
              if (raw == null) return null;
              var n = parseInt(raw, 10);
              return ALLOWED.indexOf(n) !== -1 ? n : null;
            } catch (e) {
              return null;
            }
          }
          function writeSavedWindow(n) {
            try {
              if (typeof localStorage === 'undefined') return;
              localStorage.setItem(STORAGE_KEY, String(n));
            } catch (e) { /* private mode / quota — ignore */ }
          }
          return {
            days: initial.days,
            totalPaid: initial.totalPaid,
            invoiceCount: initial.invoiceCount,
            clientCount: initial.clientCount,
            // unpaidCount drives the #127 quiet-window recovery CTA.
            // Not windowed — counts all currently open invoices
            // (status IN ('sent','overdue')) so the "send follow-ups"
            // prompt reflects every invoice that could use a nudge.
            unpaidCount: Number(initial.unpaidCount) || 0,
            loading: false,
            errored: false,
            init() {
              var saved = readSavedWindow();
              if (saved !== null && saved !== this.days) {
                // Init-driven restoration is silent on failure — the user
                // didn't click anything, surfacing a red error line for a
                // background restoration would be confusing. Falling back
                // to the SSR-rendered window with no message is the right
                // graceful-degrade.
                this.select(saved, { silent: true });
              }
            },
            formatMoney(n) {
              const v = Number(n) || 0;
              return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            },
            async select(window, opts) {
              if (window === this.days || this.loading) return;
              var silent = opts && opts.silent === true;
              this.loading = true;
              this.errored = false;
              try {
                const r = await fetch('/invoices/api/recent-revenue?days=' + encodeURIComponent(window), {
                  headers: { 'Accept': 'application/json' },
                  credentials: 'same-origin'
                });
                if (!r.ok) throw new Error('http_' + r.status);
                const data = await r.json();
                // card === null means "no paid invoices in this window" — that's
                // valid data, not an error. Show zeros honestly so the user
                // gets the truthful "no, you weren't paid this week" answer.
                this.days = data.days || window;
                if (data.card) {
                  this.totalPaid = data.card.totalPaid;
                  this.invoiceCount = data.card.invoiceCount;
                  this.clientCount = data.card.clientCount;
                  // unpaidCount may be absent on legacy API shapes —
                  // preserve the existing value rather than zeroing it,
                  // so the CTA stays accurate during a partial deploy.
                  if (typeof data.card.unpaidCount === 'number') {
                    this.unpaidCount = data.card.unpaidCount;
                  }
                } else {
                  this.totalPaid = 0;
                  this.invoiceCount = 0;
                  this.clientCount = 0;
                  // card === null means no paid invoices in the window;
                  // the unpaidCount field is still useful so the CTA
                  // can fire. Read from the top-level response if present.
                  if (typeof data.unpaidCount === 'number') {
                    this.unpaidCount = data.unpaidCount;
                  }
                }
                // Only persist after a successful fetch — never persist
                // a window the server couldn't honour.
                writeSavedWindow(this.days);
              } catch (e) {
                if (!silent) this.errored = true;
              } finally {
                this.loading = false;
              }
            }
          };
        }
      </script>
    <% } %>
    <% if (locals.recentRevenue && recentRevenue) { %>
      <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">All-time totals</p>
    <% } %>
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Total Invoiced</p>
        <p class="text-2xl font-bold text-gray-900">$<%= total.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Collected</p>
        <p class="text-2xl font-bold text-green-600">$<%= paid.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Outstanding</p>
        <p class="text-2xl font-bold text-orange-500">$<%= outstanding.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></p>
      </div>
    </div>

    <!-- Invoice table -->
    <% const isProUser = user && (user.plan === 'pro' || user.plan === 'agency'); %>
    <% const onlySeedInvoices = invoices.length > 0 && invoices.every((i) => i.is_seed); %>
    <%
      // Inline mirror of lib/client-view.formatViewedAgo — EJS doesn't expose
      // require, and the lib helper is unit-tested in isolation; keeping a
      // tight inline copy here means the dashboard render has zero require
      // surface. Identical bucket boundaries (60s / 60m / 24h / 30d / 365d).
      function dashboardViewedLabel(inv) {
        if (!inv || inv.is_seed || !inv.first_viewed_at) return null;
        const first = new Date(inv.first_viewed_at);
        if (!Number.isFinite(first.getTime())) return null;
        const last = inv.last_viewed_at ? new Date(inv.last_viewed_at) : first;
        const ref = Number.isFinite(last.getTime()) ? last : first;
        const delta = Math.max(0, Date.now() - ref.getTime());
        const sec = Math.floor(delta / 1000);
        let ago;
        if (sec < 60) ago = 'just now';
        else if (sec < 3600) ago = Math.floor(sec / 60) + 'm ago';
        else if (sec < 86400) ago = Math.floor(sec / 3600) + 'h ago';
        else if (sec < 86400 * 30) ago = Math.floor(sec / 86400) + 'd ago';
        else if (sec < 86400 * 365) ago = Math.floor(sec / (86400 * 30)) + 'mo ago';
        else ago = Math.floor(sec / (86400 * 365)) + 'y ago';
        const count = Number(inv.view_count || 1) || 1;
        return count > 1 ? `Viewed ${count}× (last ${ago})` : `Viewed ${ago}`;
      }
    %>
    <% if (onlySeedInvoices) { %>
      <div
        data-testid="seed-invoice-hint"
        class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-5 py-3 flex items-start gap-3 print:hidden"
        role="region"
        aria-label="Sample invoice ready to edit"
      >
        <div class="text-amber-500 text-lg leading-none mt-0.5" aria-hidden="true">&#9999;</div>
        <p class="text-sm text-amber-900 flex-1">
          <strong>This is a sample invoice.</strong> Open it, replace the client and line items, and you'll have your first real invoice ready to send &mdash; it doesn't count against your free limit.
        </p>
      </div>
    <% } %>
    <div id="invoices-table" class="bg-white rounded-2xl border border-gray-200 overflow-hidden scroll-mt-6">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Invoice</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Client</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Date</th>
            <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Amount</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
            <% if (isProUser) { %>
              <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide print:hidden">Pay link</th>
            <% } %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% invoices.forEach(inv => { %>
            <tr class="hover:bg-gray-50 cursor-pointer" data-is-seed="<%= inv.is_seed ? 'true' : 'false' %>" onclick="window.location='/invoices/<%= inv.id %>'">
              <td class="px-6 py-4 font-medium text-brand-600">
                <%= inv.invoice_number %>
                <% if (inv.is_seed) { %>
                  <span data-testid="seed-invoice-badge" class="ml-2 inline-block text-[10px] font-semibold uppercase tracking-wide bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded">Example</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-gray-700"><%= inv.client_name %></td>
              <td class="px-6 py-4 text-gray-500"><%= new Date(inv.issued_date).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></td>
              <td class="px-6 py-4 text-right font-semibold text-gray-900">$<%= parseFloat(inv.total).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
              <td class="px-6 py-4">
                <%
                  const statusColors = {
                    draft: 'bg-gray-100 text-gray-600',
                    sent: 'bg-blue-100 text-blue-700',
                    paid: 'bg-green-100 text-green-700',
                    overdue: 'bg-red-100 text-red-700'
                  };
                %>
                <span class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full <%= statusColors[inv.status] || 'bg-gray-100 text-gray-600' %>">
                  <%= inv.status.charAt(0).toUpperCase() + inv.status.slice(1) %>
                </span>
                <% const viewedLabel = dashboardViewedLabel(inv); %>
                <% if (viewedLabel) { %>
                  <span
                    data-testid="client-viewed-<%= inv.id %>"
                    data-view-count="<%= inv.view_count || 1 %>"
                    class="ml-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded"
                    title="Your client opened the shared invoice link"
                  >
                    <span aria-hidden="true">&#128064;</span>
                    <%= viewedLabel %>
                  </span>
                <% } %>
                <%
                  // Client-side payment-claim badge (Milestone 4 — sent → paid).
                  // The client clicked "I've sent payment" on the public
                  // /i/<token> page. Surfaces verbatim on every row that has a
                  // claim and hasn't yet been marked paid, with a method label
                  // so the freelancer knows where to look for the deposit. A
                  // paid invoice never shows the badge — the green Paid pill
                  // already conveys the resolved state.
                  const claimMethodLabels = { cash: 'Cash', check: 'Cheque', venmo: 'Venmo', zelle: 'Zelle', bank_transfer: 'Bank transfer', paypal: 'PayPal', other: 'Other' };
                  const showClaim = !inv.is_seed && inv.payment_claimed_at && inv.status !== 'paid';
                  const claimMethodLabel = inv.payment_claim_method ? (claimMethodLabels[inv.payment_claim_method] || 'Other') : '';
                %>
                <% if (showClaim) { %>
                  <span
                    data-testid="client-payment-claim-<%= inv.id %>"
                    data-claim-method="<%= inv.payment_claim_method || 'other' %>"
                    class="ml-2 inline-flex items-center gap-1 text-[11px] font-medium text-amber-800 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded"
                    title="Your client reports they sent payment. Verify against your account and mark paid."
                  >
                    <span aria-hidden="true">&#128184;</span>
                    Client reports paid<% if (claimMethodLabel) { %> via <%= claimMethodLabel %><% } %>
                  </span>
                <% } %>
                <%
                  // Per-row "Send reminder" follow-up cluster (Milestone 4 —
                  // first invoice sent → first payment received). Surfaces on
                  // every sent/overdue row that carries a public_token AND
                  // does not have a pending payment-claim. The single-banner
                  // prompt stack (recentView / clientViewedFollowup /
                  // sentNotViewed / overdue) only ever surfaces the OLDEST
                  // qualifying invoice — this fills the long-tail gap so a
                  // freelancer with 3+ open unpaid invoices can fire a
                  // one-tap WhatsApp / SMS / Email / Copy follow-up on any
                  // of them straight from the table view.
                  const tableIntents = (locals.tableFollowUpIntents && tableFollowUpIntents[String(inv.id)]) || null;
                %>
                <% if (tableIntents && !showClaim) { %>
                  <div
                    class="mt-2 print:hidden inline-block relative align-top"
                    x-data="{ open: false }"
                    @click.outside="open = false"
                    @keydown.escape.window="open = false"
                    onclick="event.stopPropagation()"
                    data-testid="table-reminder-<%= inv.id %>"
                  >
                    <button
                      type="button"
                      data-testid="table-reminder-toggle-<%= inv.id %>"
                      @click.stop="open = !open"
                      :aria-expanded="open ? 'true' : 'false'"
                      aria-haspopup="true"
                      class="inline-flex items-center gap-1 text-[11px] font-semibold text-orange-800 bg-orange-50 border border-orange-200 px-2 py-0.5 rounded hover:bg-orange-100 transition"
                    >
                      <span aria-hidden="true">&#128228;</span>
                      <span>Send reminder</span>
                      <span aria-hidden="true" x-text="open ? '▴' : '▾'">▾</span>
                    </button>
                    <div
                      x-show="open"
                      x-cloak
                      x-transition.opacity
                      data-testid="table-reminder-popover-<%= inv.id %>"
                      class="absolute z-20 left-0 mt-1 bg-white border border-orange-200 rounded-lg shadow-lg p-2 flex flex-wrap gap-1.5 min-w-[180px]"
                      onclick="event.stopPropagation()"
                    >
                      <a
                        href="<%= tableIntents.followUpIntents.whatsapp %>"
                        target="_blank"
                        rel="noopener"
                        data-testid="table-reminder-whatsapp-<%= inv.id %>"
                        onclick="try { fetch('/invoices/<%= inv.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'whatsapp' }) }).catch(function(){}); } catch (e) {}"
                        class="inline-flex items-center gap-1 bg-white border border-orange-300 text-orange-800 font-semibold px-2 py-1 rounded hover:bg-green-50 hover:border-green-400 transition text-[11px]"
                      >
                        <span aria-hidden="true">&#128172;</span><span>WhatsApp</span>
                      </a>
                      <a
                        href="<%= tableIntents.followUpIntents.sms %>"
                        data-testid="table-reminder-sms-<%= inv.id %>"
                        onclick="try { fetch('/invoices/<%= inv.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'sms' }) }).catch(function(){}); } catch (e) {}"
                        class="inline-flex items-center gap-1 bg-white border border-orange-300 text-orange-800 font-semibold px-2 py-1 rounded hover:bg-blue-50 hover:border-blue-400 transition text-[11px]"
                      >
                        <span aria-hidden="true">&#128241;</span><span>SMS</span>
                      </a>
                      <% if (tableIntents.followUpIntents.mailto) { %>
                        <a
                          href="<%= tableIntents.followUpIntents.mailto %>"
                          data-testid="table-reminder-email-<%= inv.id %>"
                          onclick="try { fetch('/invoices/<%= inv.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'email' }) }).catch(function(){}); } catch (e) {}"
                          class="inline-flex items-center gap-1 bg-white border border-orange-300 text-orange-800 font-semibold px-2 py-1 rounded hover:bg-indigo-50 hover:border-indigo-400 transition text-[11px]"
                        >
                          <span aria-hidden="true">&#9993;&#65039;</span><span>Email</span>
                        </a>
                      <% } %>
                      <button
                        type="button"
                        data-testid="table-reminder-copy-<%= inv.id %>"
                        data-share-url="<%= tableIntents.url %>"
                        onclick="(function(btn){ try { var u = btn.getAttribute('data-share-url') || ''; fetch('/invoices/<%= inv.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'copy' }) }).catch(function(){}); if (u && typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') { navigator.clipboard.writeText(u).then(function(){ var prev = btn.innerHTML; btn.innerHTML = '<span>Copied!</span>'; setTimeout(function(){ btn.innerHTML = prev; }, 2000); }).catch(function(){}); } } catch (e) {} })(this)"
                        class="inline-flex items-center gap-1 bg-white border border-orange-300 text-orange-800 font-semibold px-2 py-1 rounded hover:bg-orange-100 transition text-[11px]"
                      >
                        <span aria-hidden="true">&#128279;</span><span>Copy link</span>
                      </button>
                    </div>
                  </div>
                <% } %>
              </td>
              <% if (isProUser) { %>
                <td class="px-4 py-4 text-right print:hidden" onclick="event.stopPropagation()">
                  <% if (inv.payment_link_url) { %>
                    <span x-data="{ copied: false }" class="inline-flex">
                      <button
                        type="button"
                        data-pay-link-url="<%= inv.payment_link_url %>"
                        @click.stop="navigator.clipboard.writeText($event.currentTarget.dataset.payLinkUrl).then(() => { copied = true; setTimeout(() => copied = false, 2000); })"
                        data-testid="copy-pay-link-<%= inv.id %>"
                        :title="copied ? 'Copied to clipboard' : 'Copy payment link'"
                        :aria-label="copied ? 'Payment link copied' : 'Copy payment link to clipboard'"
                        class="inline-flex items-center gap-1.5 border border-gray-200 text-gray-600 hover:text-brand-700 hover:border-brand-300 hover:bg-brand-50 px-2.5 py-1.5 rounded-lg transition text-xs font-medium"
                      >
                        <svg x-show="!copied" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span x-show="!copied">Copy link</span>
                        <svg x-show="copied" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span x-show="copied" class="text-green-600">Copied</span>
                      </button>
                    </span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <!--
    iOS "Add to Home Screen" install tile (Milestone 1 — signup → first
    dashboard re-entry). Chrome/Edge/Android show a native install affordance
    in the URL bar or via beforeinstallprompt, but iOS Safari hides the path
    inside the Share sheet where most users never look. A home-screen icon
    converts the app from "another URL I have to remember" into a one-tap
    launcher that visibly compounds re-entry rate for the dominant freelancer
    device. Only renders when (a) UA detection identifies iOS Safari (not
    Chrome iOS, not Firefox iOS, not in-app webviews), (b) the page is NOT
    already running in standalone display-mode, and (c) the user hasn't
    dismissed it (localStorage). Self-contained Alpine factory — no server
    state, no DB hit, no PII.
  -->
  <div
    x-data="installToHomeScreenTile()"
    x-init="evaluate()"
    x-show="visible"
    x-cloak
    data-testid="install-home-screen-tile"
    class="mt-8 rounded-2xl border border-brand-200 bg-brand-50 px-5 py-4 flex items-start gap-3 print:hidden"
    role="region"
    aria-label="Add DecentInvoice to your home screen"
  >
    <div class="text-brand-600 text-xl leading-none mt-0.5" aria-hidden="true">📲</div>
    <div class="flex-1 text-sm">
      <p class="font-semibold text-brand-800">Add DecentInvoice to your home screen</p>
      <p class="text-brand-700 mt-0.5">
        Open invoices and chase payment in one tap, no more typing the URL.
        Tap the
        <span aria-hidden="true" class="inline-flex items-center justify-center w-4 h-5 border border-brand-500 rounded text-[10px] font-bold align-middle">&#x2191;</span>
        Share button below, then choose
        <strong>Add to Home Screen</strong>.
      </p>
      <button
        type="button"
        data-testid="install-home-screen-dismiss"
        @click="dismiss()"
        class="mt-2 text-brand-700 text-xs font-medium underline hover:text-brand-900"
      >Not now</button>
    </div>
  </div>

  <script data-testid="install-home-screen-script">
    function installToHomeScreenTile() {
      return {
        visible: false,
        STORAGE_KEY: 'qi.installTileDismissed',
        isIOSSafari() {
          try {
            var ua = (typeof navigator !== 'undefined' && navigator.userAgent) ? navigator.userAgent : '';
            if (!/iPhone|iPad|iPod/i.test(ua)) return false;
            // Exclude Chrome iOS (CriOS), Firefox iOS (FxiOS), Edge (EdgiOS), in-app webviews (FBAN/FBAV/Instagram/Line/WeChat).
            if (/CriOS|FxiOS|EdgiOS|OPiOS|FBAN|FBAV|Instagram|Line|MicroMessenger/.test(ua)) return false;
            // Real Safari has "Safari/" in the UA.
            return /Safari\//.test(ua);
          } catch (e) { return false; }
        },
        isStandalone() {
          try {
            if (typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) return true;
            if (typeof navigator !== 'undefined' && navigator.standalone === true) return true;
          } catch (e) {}
          return false;
        },
        readDismissed() {
          try { return typeof localStorage !== 'undefined' && localStorage.getItem(this.STORAGE_KEY) === '1'; }
          catch (e) { return false; }
        },
        evaluate() {
          this.visible = this.isIOSSafari() && !this.isStandalone() && !this.readDismissed();
        },
        dismiss() {
          this.visible = false;
          try { if (typeof localStorage !== 'undefined') localStorage.setItem(this.STORAGE_KEY, '1'); }
          catch (e) {}
        }
      };
    }
  </script>
</div>

<%- include('partials/upgrade-modal') %>

<%- include('partials/footer') %>

</body>
</html>
