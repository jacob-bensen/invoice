<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="max-w-5xl mx-auto px-4 py-10">
  <% if (locals.onboarding && onboarding && !onboarding.allDone) { %>
    <div
      data-testid="onboarding-checklist"
      class="mb-6 rounded-xl border border-blue-200 bg-blue-50 px-5 py-4 print:hidden"
      role="region"
      aria-label="Getting started checklist"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="font-semibold text-blue-900">Get up and running</h2>
          <p class="text-blue-700 text-sm mt-0.5">
            <%= onboarding.completed %> of <%= onboarding.total %> steps complete &mdash; finish setup to start getting paid.
          </p>
        </div>
        <form action="/onboarding/dismiss" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button
            type="submit"
            class="text-blue-500 hover:text-blue-800 text-xs font-medium underline"
            aria-label="Dismiss onboarding checklist"
          >Dismiss</button>
        </form>
      </div>
      <ul class="mt-4 space-y-2">
        <% onboarding.steps.forEach((step) => { %>
          <li
            class="flex items-center gap-3 text-sm"
            data-testid="onboarding-step-<%= step.key %>"
            data-done="<%= step.done ? 'true' : 'false' %>"
          >
            <span class="<%= step.done ? 'text-green-600' : 'text-gray-300' %> text-lg leading-none w-5 inline-block">
              <% if (step.done) { %>&#10003;<% } else { %>&#9711;<% } %>
            </span>
            <% if (step.done) { %>
              <span class="text-gray-500 line-through"><%= step.label %></span>
            <% } else { %>
              <a href="<%= step.href %>" class="text-blue-700 font-medium hover:underline"><%= step.label %> &rarr;</a>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (locals.days_left_in_trial && days_left_in_trial > 0) { %>
    <% const trialLastDay = days_left_in_trial === 1; %>
    <% const trialEndsIso = (user && user.trial_ends_at) ? new Date(user.trial_ends_at).toISOString() : ''; %>
    <div
      x-data="{ dismissed: false, hoursRemaining: '', tickHoursRemaining() { const ends = this.$el.dataset.trialEndsAt; if (!ends) { this.hoursRemaining = ''; return; } const ms = new Date(ends).getTime() - Date.now(); if (!isFinite(ms) || ms <= 0) { this.hoursRemaining = ''; return; } const totalMinutes = Math.floor(ms / 60000); const h = Math.floor(totalMinutes / 60); const m = totalMinutes % 60; this.hoursRemaining = h > 0 ? (h + 'h ' + m + 'm') : (m + 'm'); } }"
      x-init="tickHoursRemaining(); setInterval(() => tickHoursRemaining(), 60000)"
      data-trial-ends-at="<%= trialEndsIso %>"
      x-show="!dismissed"
      x-cloak
      data-testid="trial-banner"
      data-trial-urgent="<%= trialLastDay ? 'true' : 'false' %>"
      class="mb-6 rounded-xl border <%= trialLastDay ? 'border-red-200 bg-red-50' : 'border-blue-200 bg-blue-50' %> px-5 py-4 flex items-start gap-3"
      role="<%= trialLastDay ? 'alert' : 'status' %>"
    >
      <div class="<%= trialLastDay ? 'text-red-500' : 'text-blue-500' %> text-xl leading-none mt-0.5">
        <% if (trialLastDay) { %>&#9200;<% } else { %>&#127881;<% } %>
      </div>
      <div class="flex-1 text-sm">
        <p class="font-semibold <%= trialLastDay ? 'text-red-800' : 'text-blue-800' %>">
          <% if (trialLastDay) { %>
            Last day of your Pro trial — add a card before midnight to keep Pro features.
          <% } else { %>
            You're on a Pro trial — <%= days_left_in_trial %> days left.
          <% } %>
        </p>
        <p class="<%= trialLastDay ? 'text-red-700' : 'text-blue-700' %> mt-0.5">
          <% if (trialLastDay) { %>
            Without a card on file, payment links and reminders pause when your trial ends.
          <% } else { %>
            Add a payment method to keep Pro features when your trial ends. No charge today.
          <% } %>
        </p>
        <% if (trialLastDay) { %>
          <p class="mt-2" data-testid="trial-urgent-hours-remaining" x-show="hoursRemaining" x-cloak>
            <span class="inline-flex items-center gap-1.5 text-red-800 text-xs font-semibold">
              <span aria-hidden="true">&#9203;</span>
              Trial ends in <span data-testid="trial-urgent-hours-remaining-value" x-text="hoursRemaining"></span>
            </span>
          </p>
          <p class="mt-2" data-testid="trial-urgent-annual-pill">
            <span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-full">
              <span aria-hidden="true">&#128176;</span>
              Lock in $99/year &mdash; 3 months free
            </span>
          </p>
          <% if (locals.socialProof) { %>
            <p class="mt-2" data-testid="trial-urgent-social-proof">
              <span class="inline-flex items-center gap-1.5 bg-red-100 text-red-800 text-xs font-semibold px-2 py-1 rounded-full">
                <span aria-hidden="true">&#128101;</span>
                <% if (socialProof.count) { %>
                  Join <span data-testid="trial-urgent-social-proof-count"><%= socialProof.count.toLocaleString('en-US') %></span> freelancers on Pro
                <% } else { %>
                  <span data-testid="trial-urgent-social-proof-fallback"><%= socialProof.fallback %></span>
                <% } %>
              </span>
            </p>
          <% } %>
        <% } %>
        <form action="/billing/portal" method="POST" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button type="submit" class="inline-flex items-center gap-1.5 <%= trialLastDay ? 'bg-red-600 hover:bg-red-700' : 'bg-blue-600 hover:bg-blue-700' %> text-white font-semibold text-xs px-3 py-2 rounded-lg transition">
            Add payment method &rarr;
          </button>
        </form>
      </div>
      <button
        type="button"
        @click="dismissed = true"
        class="<%= trialLastDay ? 'text-red-400 hover:text-red-600' : 'text-blue-400 hover:text-blue-600' %> text-2xl leading-none"
        aria-label="Dismiss"
      >&times;</button>
    </div>
  <% } %>

  <% if (locals.annualUpgradePrompt && annualUpgradePrompt) { %>
    <div
      x-data="{ dismissed: false }"
      x-show="!dismissed"
      x-cloak
      data-testid="annual-upgrade-banner"
      class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 flex items-start gap-3 print:hidden"
      role="region"
      aria-label="Switch to annual billing"
    >
      <div class="text-emerald-500 text-xl leading-none mt-0.5" aria-hidden="true">&#128176;</div>
      <div class="flex-1 text-sm">
        <p class="font-semibold text-emerald-900">
          Save $<%= annualUpgradePrompt.savingsPerYear %>/year — switch to annual billing
        </p>
        <p class="text-emerald-800 mt-0.5">
          You're paying $<%= annualUpgradePrompt.monthlyPrice %>/month. Annual is $<%= annualUpgradePrompt.annualPrice %>/year — that's 3 months free and one decision instead of twelve.
        </p>
        <form action="/billing/switch-to-annual" method="POST" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button
            type="submit"
            data-testid="annual-upgrade-submit"
            class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs px-3 py-2 rounded-lg transition"
          >
            Switch to annual &mdash; lock in $<%= annualUpgradePrompt.annualPrice %>/yr &rarr;
          </button>
        </form>
      </div>
      <button
        type="button"
        @click="dismissed = true"
        class="text-emerald-400 hover:text-emerald-600 text-2xl leading-none"
        aria-label="Dismiss"
      >&times;</button>
    </div>
  <% } %>

  <% if (user && (user.subscription_status === 'past_due' || user.subscription_status === 'paused')) { %>
    <div
      x-data="{ dismissed: false }"
      x-show="!dismissed"
      x-cloak
      data-testid="past-due-banner"
      class="mb-6 rounded-xl border border-red-200 bg-red-50 px-5 py-4 flex items-start gap-3"
      role="alert"
    >
      <div class="text-red-500 text-xl leading-none mt-0.5">&#9888;</div>
      <div class="flex-1 text-sm">
        <p class="font-semibold text-red-800">
          <% if (user.subscription_status === 'paused') { %>
            Your Pro subscription is paused.
          <% } else { %>
            Your payment didn't go through.
          <% } %>
        </p>
        <p class="text-red-700 mt-0.5">
          Pro features are temporarily restricted while Stripe retries your card. Update your card to restore unlimited invoices immediately — your data is safe.
        </p>
        <form action="/billing/portal" method="POST" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button type="submit" class="inline-flex items-center gap-1.5 bg-red-600 text-white font-semibold text-xs px-3 py-2 rounded-lg hover:bg-red-700 transition">
            Update payment method &rarr;
          </button>
        </form>
      </div>
      <button
        type="button"
        @click="dismissed = true"
        class="text-red-400 hover:text-red-600 text-2xl leading-none"
        aria-label="Dismiss"
      >&times;</button>
    </div>
  <% } %>

  <%- include('partials/celebration-banner') %>

  <% if (locals.pendingQuickInvoice && pendingQuickInvoice) { %>
    <div
      data-testid="pending-quick-invoice-banner"
      class="mb-6 rounded-xl border border-brand-200 bg-brand-50 px-5 py-4 flex items-start gap-3 print:hidden"
      role="region"
      aria-label="Continue your draft invoice"
    >
      <div class="text-brand-600 text-xl leading-none mt-0.5" aria-hidden="true">&#128221;</div>
      <div class="flex-1 text-sm">
        <p class="font-semibold text-brand-800">
          Pick up your draft invoice<% if (pendingQuickInvoice.clientName) { %> for <span data-testid="pending-quick-invoice-client"><%= pendingQuickInvoice.clientName %></span><% } %>.
        </p>
        <p class="text-brand-700 mt-0.5">
          <% if (pendingQuickInvoice.description) { %>
            <span data-testid="pending-quick-invoice-description"><%= pendingQuickInvoice.description %></span><% if (pendingQuickInvoice.amount) { %> &middot; $<span data-testid="pending-quick-invoice-amount"><%= pendingQuickInvoice.amount %></span><% } %>
          <% } else if (pendingQuickInvoice.amount) { %>
            $<span data-testid="pending-quick-invoice-amount"><%= pendingQuickInvoice.amount %></span>
          <% } else { %>
            You started filling in an invoice but didn&rsquo;t finish &mdash; one click to resume.
          <% } %>
        </p>
        <div class="mt-3">
          <a
            href="/invoices/quick"
            data-testid="pending-quick-invoice-cta"
            class="bg-brand-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 transition text-sm inline-block"
          >Continue invoice &rarr;</a>
        </div>
      </div>
    </div>
  <% } %>

  <% if (locals.freshDraftPrompt && freshDraftPrompt) { %>
    <div
      data-testid="fresh-draft-prompt"
      data-invoice-id="<%= freshDraftPrompt.id %>"
      data-age-minutes="<%= freshDraftPrompt.ageMinutes %>"
      data-direct-email="<%= freshDraftPrompt.directEmail ? 'true' : 'false' %>"
      class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 flex items-start gap-3 print:hidden"
      role="region"
      aria-label="You created an invoice — send it to your client"
      x-data="{ emailSending: false, emailSent: false, emailError: '', emailSendDirect() { try { this.emailSending = true; this.emailError = ''; fetch('/invoices/<%= freshDraftPrompt.id %>/email-client', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.json().then(d => ({ ok: r.ok, status: r.status, data: d }))).then(res => { if (res.ok && res.data && res.data.ok) { this.emailSending = false; this.emailSent = true; setTimeout(() => { try { window.location.reload(); } catch (e) {} }, 1200); } else { this.emailSending = false; this.emailError = (res.data && res.data.error) || 'send_failed'; } }).catch(() => { this.emailSending = false; this.emailError = 'network_error'; }); } catch (e) { this.emailSending = false; this.emailError = 'js_error'; } } }"
    >
      <div class="text-emerald-600 text-xl leading-none mt-0.5" aria-hidden="true">&#128640;</div>
      <div class="flex-1 text-sm">
        <p class="font-semibold text-emerald-900">
          <% if (freshDraftPrompt.clientName) { %>
            You made an invoice for <strong data-testid="fresh-draft-client-name"><%= freshDraftPrompt.clientName %></strong> &mdash; now send it.
          <% } else { %>
            You made your first invoice &mdash; now send it to your client.
          <% } %>
        </p>
        <p class="text-emerald-800 mt-0.5">
          <span data-testid="fresh-draft-invoice-number"><%= freshDraftPrompt.invoiceNumber %></span>
          ($<span data-testid="fresh-draft-total"><%= freshDraftPrompt.total.toFixed(2) %></span>)
          is sitting as a draft. Your client can't see it until you share the link.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a
            href="/invoices/<%= freshDraftPrompt.id %>"
            data-testid="fresh-draft-open-link"
            class="bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-emerald-700 transition text-sm"
          >
            &#128228; Open &amp; send invoice &rarr;
          </a>
          <form action="/invoices/<%= freshDraftPrompt.id %>/status" method="POST" class="inline">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <input type="hidden" name="status" value="sent">
            <button
              type="submit"
              data-testid="fresh-draft-mark-sent"
              class="border border-emerald-300 text-emerald-800 font-semibold px-4 py-2 rounded-lg hover:bg-emerald-100 transition text-sm"
            >
              Already sent it? Mark as sent
            </button>
          </form>
        </div>
        <%
          // Direct send-by-email (Pro/Agency with client_email). Mirrors the
          // /:id draft-send-banner direct-email surface but on the dashboard
          // prompt — collapses the "dashboard → /:id → Send by email" step
          // to a single tap. POST /:id/email-client both sends via Resend and
          // atomically flips the draft to 'sent'. Reload on success so the
          // status badge + prompt disappear. Error feedback surfaces inline
          // (no_client_email / not_configured / send_failed mapped to
          // human-readable copy). Free / no-client_email users keep the
          // mailto: fallback in the share-intent row below.
        %>
        <% if (freshDraftPrompt.directEmail) { %>
          <div class="mt-3" data-testid="fresh-draft-direct-email-row">
            <button type="button"
              data-testid="fresh-draft-direct-email"
              x-bind:disabled="emailSending || emailSent"
              @click="emailSendDirect()"
              class="inline-flex items-center gap-2 bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-emerald-700 disabled:opacity-60 disabled:cursor-not-allowed transition text-sm">
              <span aria-hidden="true">&#128231;</span>
              <span x-show="!emailSending && !emailSent">Send by email to <%= freshDraftPrompt.clientEmail %></span>
              <span x-show="emailSending" x-cloak>Sending&hellip;</span>
              <span x-show="emailSent" x-cloak>&check; Sent to <%= freshDraftPrompt.clientEmail %></span>
            </button>
            <p x-show="emailError" x-cloak x-text="emailError === 'no_client_email' ? 'Add a client email on this invoice first.' : emailError === 'not_configured' ? 'Email delivery is not configured yet — use another channel below.' : 'Could not send — try another channel below.'"
              data-testid="fresh-draft-direct-email-error"
              class="text-red-600 text-xs mt-2"></p>
            <p class="text-xs text-emerald-700 mt-1">One tap — we deliver the invoice to your client&rsquo;s inbox and mark it Sent.</p>
          </div>
        <% } %>
        <%
          // One-tap share-intent buttons (WhatsApp / SMS / Copy link). When the
          // draft already has a public_token (eagerly minted at create time),
          // surfaces them inline so a mobile user can send without leaving
          // the dashboard. Each tap fires POST /share-intent which atomically
          // flips the draft to 'sent'. Falls through silently when shareIntents
          // is null (token mint pending) — the user still has the "Open &
          // send" deep-link above as the fallback path.
        %>
        <% if (freshDraftPrompt.shareIntents && freshDraftPrompt.shareIntents.url) { %>
          <div class="mt-3 flex flex-wrap items-center gap-2" data-testid="fresh-draft-share-intents">
            <span class="text-xs text-emerald-700 font-medium mr-1">or tap a channel:</span>
            <a href="<%= freshDraftPrompt.shareIntents.whatsapp %>"
              target="_blank" rel="noopener"
              data-share="whatsapp"
              data-testid="fresh-draft-share-whatsapp"
              onclick="try { fetch('/invoices/<%= freshDraftPrompt.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'whatsapp' }) }).catch(function(){}); } catch (e) {}"
              class="inline-flex items-center gap-1.5 bg-white border border-emerald-300 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg hover:bg-green-50 hover:border-green-400 transition text-xs">
              <span aria-hidden="true">&#128172;</span><span>WhatsApp</span>
            </a>
            <a href="<%= freshDraftPrompt.shareIntents.sms %>"
              data-share="sms"
              data-testid="fresh-draft-share-sms"
              onclick="try { fetch('/invoices/<%= freshDraftPrompt.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'sms' }) }).catch(function(){}); } catch (e) {}"
              class="inline-flex items-center gap-1.5 bg-white border border-emerald-300 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg hover:bg-blue-50 hover:border-blue-400 transition text-xs">
              <span aria-hidden="true">&#128241;</span><span>SMS</span>
            </a>
            <% if (freshDraftPrompt.shareIntents.mailto) { %>
              <a href="<%= freshDraftPrompt.shareIntents.mailto %>"
                data-share="email"
                data-testid="fresh-draft-share-email"
                onclick="try { fetch('/invoices/<%= freshDraftPrompt.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'email' }) }).catch(function(){}); } catch (e) {}"
                class="inline-flex items-center gap-1.5 bg-white border border-emerald-300 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg hover:bg-indigo-50 hover:border-indigo-400 transition text-xs">
                <span aria-hidden="true">&#9993;&#65039;</span><span>Email</span>
              </a>
            <% } %>
            <button type="button"
              data-share="copy"
              data-testid="fresh-draft-share-copy"
              data-share-url="<%= freshDraftPrompt.shareIntents.url %>"
              onclick="(function(btn){ try { var u = btn.getAttribute('data-share-url') || ''; fetch('/invoices/<%= freshDraftPrompt.id %>/share-intent', { method: 'POST', keepalive: true, headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ intent: 'copy' }) }).catch(function(){}); if (u && typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') { navigator.clipboard.writeText(u).then(function(){ var prev = btn.innerHTML; btn.innerHTML = '<span>Copied!</span>'; setTimeout(function(){ btn.innerHTML = prev; }, 2000); }).catch(function(){}); } } catch (e) {} })(this)"
              class="inline-flex items-center gap-1.5 bg-white border border-emerald-300 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg hover:bg-emerald-100 transition text-xs">
              <span aria-hidden="true">&#128279;</span><span>Copy link</span>
            </button>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (locals.staleDraftPrompt && staleDraftPrompt) { %>
    <div
      data-testid="stale-draft-prompt"
      data-invoice-id="<%= staleDraftPrompt.id %>"
      data-hours-old="<%= staleDraftPrompt.hoursOld %>"
      data-direct-email="<%= staleDraftPrompt.directEmail ? 'true' : 'false' %>"
      class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 flex items-start gap-3 print:hidden"
      role="region"
      aria-label="Draft invoice waiting to be sent"
      x-data="{ emailSending: false, emailSent: false, emailError: '', emailSendDirect() { try { this.emailSending = true; this.emailError = ''; fetch('/invoices/<%= staleDraftPrompt.id %>/email-client', { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>', 'Accept': 'application/json' } }).then(r => r.json().then(d => ({ ok: r.ok, status: r.status, data: d }))).then(res => { if (res.ok && res.data && res.data.ok) { this.emailSending = false; this.emailSent = true; setTimeout(() => { try { window.location.reload(); } catch (e) {} }, 1200); } else { this.emailSending = false; this.emailError = (res.data && res.data.error) || 'send_failed'; } }).catch(() => { this.emailSending = false; this.emailError = 'network_error'; }); } catch (e) { this.emailSending = false; this.emailError = 'js_error'; } } }"
    >
      <div class="text-amber-500 text-xl leading-none mt-0.5" aria-hidden="true">&#128228;</div>
      <div class="flex-1 text-sm">
        <p class="font-semibold text-amber-900">
          Your draft is waiting — your client can't see it yet.
        </p>
        <p class="text-amber-800 mt-0.5">
          <span data-testid="stale-draft-invoice-number"><%= staleDraftPrompt.invoiceNumber %></span>
          for
          <strong data-testid="stale-draft-client-name"><%= staleDraftPrompt.clientName %></strong>
          ($<span data-testid="stale-draft-total"><%= staleDraftPrompt.total.toFixed(2) %></span>)
          has been a draft for <%= staleDraftPrompt.hoursOld %>+ hours.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <form action="/invoices/<%= staleDraftPrompt.id %>/status" method="POST" class="inline">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <input type="hidden" name="status" value="sent">
            <button
              type="submit"
              data-testid="stale-draft-mark-sent"
              class="bg-amber-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-amber-700 transition text-sm"
            >
              &#128228; Mark as Sent
            </button>
          </form>
          <a
            href="/invoices/<%= staleDraftPrompt.id %>"
            data-testid="stale-draft-view-link"
            class="border border-amber-300 text-amber-800 font-semibold px-4 py-2 rounded-lg hover:bg-amber-100 transition text-sm"
          >
            Open invoice &rarr;
          </a>
        </div>
        <% if (staleDraftPrompt.directEmail) { %>
          <div class="mt-3" data-testid="stale-draft-direct-email-row">
            <button type="button"
              data-testid="stale-draft-direct-email"
              x-bind:disabled="emailSending || emailSent"
              @click="emailSendDirect()"
              class="inline-flex items-center gap-2 bg-amber-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-amber-700 disabled:opacity-60 disabled:cursor-not-allowed transition text-sm">
              <span aria-hidden="true">&#128231;</span>
