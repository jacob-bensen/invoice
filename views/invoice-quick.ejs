<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  const sub = (locals.submitted && typeof submitted === 'object') ? submitted : {};
  const initialClientName = typeof sub.client_name === 'string' ? sub.client_name : '';
  const initialClientEmail = typeof sub.client_email === 'string' ? sub.client_email : '';
  const initialDescription = typeof sub.description === 'string' ? sub.description : '';
  const initialAmount = typeof sub.amount === 'string' || typeof sub.amount === 'number' ? sub.amount : '';
  const initialPaymentInstructions = typeof sub.payment_instructions === 'string' ? sub.payment_instructions : '';
  const initialBusinessName = typeof sub.business_name === 'string' ? sub.business_name : '';
  const planName = (locals.user && typeof user.plan === 'string') ? user.plan : 'free';
  const canEmailFromForm = planName === 'pro' || planName === 'agency';
  // Free-tier users with no Stripe Pay button and no payment_instructions
  // set yet: their first share link shows the invoice but no way for the
  // client to actually pay. Capturing instructions here, before the invoice
  // exists, closes the race where the user shares the invoice before the
  // post-create inline prompt on /invoices/:id can land.
  const ownerPaymentInstructions = (locals.user && typeof user.payment_instructions === 'string')
    ? user.payment_instructions.trim() : '';
  const showPaymentInstructionsCapture = planName === 'free' && ownerPaymentInstructions.length === 0;
  // Inline business-name capture (Milestone 3 — first invoice created →
  // first invoice sent). Signup only takes name/email/password — a fresh
  // user reaching /invoices/quick has users.business_name = NULL, so the
  // rendered invoice header says "Your Business" and the public share
  // page introduces them to their client as "A DecentInvoice user". Both
  // unsubtle deterrents to actually clicking Send. Capturing the brand
  // here, before the invoice exists, means the very first share already
  // carries the user's real business name on every surface the client
  // sees. Plan-agnostic — Pro/Agency owners hit the exact same gap when
  // they upgraded before filling in settings.
  const ownerBusinessName = (locals.user && typeof user.business_name === 'string')
    ? user.business_name.trim() : '';
  const showBusinessNameCapture = ownerBusinessName.length === 0;
  // Recent clients quick-pick. Helper-coerced to [] on a route-level DB
  // failure; defensively re-coerced here so a future caller passing through
  // a malformed locals shape can't 500 the form. Empty list → dropdown
  // omitted entirely (no empty <select> shipping to first-time users).
  const recentClientsList = (locals.recentClients && Array.isArray(recentClients))
    ? recentClients : [];
  // Recent items quick-pick — same shape contract as recent clients but
  // sourced from past invoices.items[] (description + amount per line).
  // Picking fills the description + amount fields of the quick form;
  // the user can still edit either before submit. Empty list → dropdown
  // omitted entirely so day-zero accounts (and seed-only accounts, which
  // the SQL filters out at source) never see a useless empty control.
  const rawRecentItems = (locals.recentItems && Array.isArray(recentItems))
    ? recentItems : [];
  const recentItemsList = rawRecentItems
    .filter(it => it
      && typeof it.description === 'string'
      && it.description.trim().length > 0
      && Number.isFinite(Number(it.amount))
      && Number(it.amount) > 0)
    .map(it => ({
      description: String(it.description).trim().slice(0, 80),
      amount: Number(it.amount)
    }));
%>

<div class="max-w-xl mx-auto px-4 py-10" data-testid="invoice-quick">
  <div class="flex items-center gap-3 mb-6">
    <a href="/invoices" class="text-gray-400 hover:text-gray-600 text-sm">&larr; Invoices</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-2xl font-bold text-gray-900">Quick invoice</h1>
  </div>

  <% if (locals.welcome && welcome) {
       const firstName = (locals.user && typeof user.name === 'string')
         ? user.name.split(/\s+/)[0].trim() : '';
  %>
    <div
      data-testid="invoice-quick-welcome-banner"
      class="mb-6 rounded-2xl border border-brand-200 bg-brand-50 px-5 py-5"
      role="region"
      aria-label="Welcome to DecentInvoice"
    >
      <p class="text-lg font-semibold text-brand-900">
        <% if (firstName) { %>
          👋 Welcome aboard, <strong data-testid="invoice-quick-welcome-firstname"><%= firstName %></strong> &mdash; let&rsquo;s send your first invoice.
        <% } else { %>
          👋 Welcome aboard &mdash; let&rsquo;s send your first invoice.
        <% } %>
      </p>
      <p class="text-sm text-brand-800 mt-1">
        Three fields below is all it takes. We&rsquo;ll fill in the date, a 30-day due date, and the invoice number for you.
      </p>
      <p class="text-xs text-brand-700 mt-3">
        We also added a sample invoice to your dashboard so you can see what a finished one looks like.
        <a href="/dashboard" data-testid="invoice-quick-welcome-skip"
          class="underline hover:text-brand-900">Skip to your dashboard &rarr;</a>
      </p>
    </div>
  <% } %>

  <p class="text-sm text-gray-500 mb-6">
    Just three fields. We&rsquo;ll fill in today&rsquo;s date, a 30-day due date, and the next invoice number for you. Need line items, tax, or notes?
    <a href="/invoices/new" class="text-brand-600 underline hover:text-brand-700" data-testid="invoice-quick-advanced-link">Use the advanced form &rarr;</a>
  </p>

  <% if (locals.flash) { %>
    <div class="mb-6 p-3 rounded-lg text-sm bg-red-50 text-red-700 border border-red-200" data-testid="invoice-quick-flash">
      <%= flash.message %>
    </div>
  <% } %>

  <% if (locals.pendingRestored && pendingRestored && !locals.flash) { %>
    <div class="mb-6 p-3 rounded-lg text-sm bg-amber-50 text-amber-800 border border-amber-200" data-testid="invoice-quick-restored">
      &#128203; Picked up where you left off. Edit anything below, then create the invoice.
    </div>
  <% } %>

  <form action="/invoices/quick" method="POST" class="bg-white rounded-2xl border border-gray-200 p-6 space-y-4" data-testid="invoice-quick-form"
    x-data="quickInvoiceAutosave(<%= JSON.stringify({
      client_name: initialClientName,
      client_email: initialClientEmail,
      description: initialDescription,
      amount: typeof initialAmount === 'number' ? String(initialAmount) : initialAmount
    }) %>, <%= JSON.stringify(recentClientsList) %>, <%= JSON.stringify(recentItemsList) %>)"
    x-init="init()"
    @submit="onSubmit()">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

    <% if (showBusinessNameCapture) { %>
      <div data-testid="invoice-quick-business-name-block"
        class="rounded-lg border border-sky-200 bg-sky-50 p-4">
        <label class="block text-sm font-semibold text-sky-900 mb-1" for="quick-business-name">
          💼 Your business name <span class="text-sky-700 font-normal text-xs">(appears as the sender on every invoice)</span>
        </label>
        <p class="text-xs text-sky-800 mb-2">
          Without this your invoice will just say &ldquo;Your Business&rdquo; at the top &mdash; clients are less likely to pay something that doesn&rsquo;t look branded.
        </p>
        <input id="quick-business-name" type="text" name="business_name"
          maxlength="255"
          data-testid="invoice-quick-business-name-input"
          placeholder="Acme Studio, or your own name"
          value="<%= initialBusinessName %>"
          class="w-full border border-sky-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400">
        <p class="text-xs text-sky-700 mt-2">
          Saved to your account &mdash; every invoice you share from now on will show this.
        </p>
      </div>
    <% } %>

    <% if (recentClientsList.length > 0) { %>
      <div data-recent-clients data-testid="invoice-quick-recent-clients">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-recent-client-picker">
          Recent clients
        </label>
        <select id="quick-recent-client-picker"
          data-testid="invoice-quick-recent-clients-select"
          x-model="picked" @change="fillFromRecent()"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">Quick-pick from recent&hellip;</option>
          <% recentClientsList.forEach(function(c, idx) { %>
            <option value="<%= idx %>"><%= c.client_name %><%= c.client_email ? ' · ' + c.client_email : '' %></option>
          <% }) %>
        </select>
        <p class="text-xs text-gray-400 mt-1">Selecting fills the fields below &mdash; you can still edit them.</p>
      </div>
    <% } %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-client-name">
        Client name <span class="text-red-400">*</span>
      </label>
      <input id="quick-client-name" type="text" name="client_name" required
        placeholder="Acme Corp"
        value="<%= initialClientName %>"
        x-model="fields.client_name"
        @input.debounce.800ms="autosave()"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-client-email">
        Client email <span class="text-gray-400 font-normal text-xs">(<% if (canEmailFromForm) { %>needed to email the invoice in one tap<% } else { %>optional<% } %>)</span>
      </label>
      <input id="quick-client-email" type="email" name="client_email"
        placeholder="billing@acme.com"
        value="<%= initialClientEmail %>"
        x-model="fields.client_email"
        @input.debounce.800ms="autosave()"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <% if (recentItemsList.length > 0) { %>
      <div data-recent-items data-testid="invoice-quick-recent-items">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-recent-item-picker">
          Recent items
        </label>
        <select id="quick-recent-item-picker"
          data-testid="invoice-quick-recent-items-select"
          x-model="pickedItem" @change="fillFromRecentItem()"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">Quick-pick a past item&hellip;</option>
          <% recentItemsList.forEach(function(it, idx) { %>
            <option value="<%= idx %>"><%= it.description %> · $<%= it.amount.toFixed(2) %></option>
          <% }) %>
        </select>
        <p class="text-xs text-gray-400 mt-1">Selecting fills the line below &mdash; you can still edit it.</p>
      </div>
    <% } %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-description">
        What did you do? <span class="text-red-400">*</span>
      </label>
      <input id="quick-description" type="text" name="description" required
        placeholder="Logo design — June project"
        value="<%= initialDescription %>"
        x-model="fields.description"
        @input.debounce.800ms="autosave()"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      <p class="text-xs text-gray-400 mt-1">A single line. Add more line items later by editing the invoice.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-amount">
        Amount (USD) <span class="text-red-400">*</span>
      </label>
      <div class="flex items-center">
        <span class="inline-flex items-center px-3 py-2 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-sm text-gray-500">$</span>
        <input id="quick-amount" type="number" name="amount" required min="0.01" step="0.01"
          placeholder="500.00"
          value="<%= initialAmount %>"
          x-model="fields.amount"
          @input.debounce.800ms="autosave()"
          class="flex-1 border border-gray-300 rounded-r-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>

    <% if (showPaymentInstructionsCapture) { %>
      <div data-testid="invoice-quick-payment-instructions-block"
        class="rounded-lg border border-amber-200 bg-amber-50 p-4">
        <label class="block text-sm font-semibold text-amber-900 mb-1" for="quick-payment-instructions">
          💰 How will your client pay you? <span class="text-amber-700 font-normal text-xs">(optional, shows on the share link)</span>
        </label>
        <p class="text-xs text-amber-800 mb-2">
          On the free plan your share link has no Pay button — give your client a way to send the money. Venmo, Zelle, bank, cheque, anything.
        </p>
        <textarea id="quick-payment-instructions" name="payment_instructions"
          rows="3" maxlength="2000"
          data-testid="invoice-quick-payment-instructions-input"
          placeholder="Venmo @yourhandle&#10;Zelle: you@bank.com&#10;Bank: Chase, routing 021000021, acct 1234567890"
          class="w-full border border-amber-200 rounded-lg px-3 py-2 text-sm font-mono bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"><%= initialPaymentInstructions %></textarea>
        <p class="text-xs text-amber-700 mt-2">
          Saved to your account — every invoice you share from now on will show these.
        </p>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
      <a href="/invoices" class="text-gray-500 hover:text-gray-700 text-sm order-2 sm:order-1">Cancel</a>
      <div class="flex flex-col sm:flex-row gap-2 sm:items-center order-1 sm:order-2">
        <% if (canEmailFromForm) { %>
          <button type="submit"
            name="action" value="create_only"
            data-testid="invoice-quick-submit-draft"
            class="text-brand-700 hover:text-brand-800 hover:underline text-sm font-medium px-4 py-3 text-center">
            Save as draft
          </button>
          <button type="submit"
            name="action" value="create_and_email"
            data-testid="invoice-quick-submit"
            data-action="create_and_email"
            :disabled="!fields.client_email || !fields.client_email.trim()"
            :class="!fields.client_email || !fields.client_email.trim()
              ? 'bg-brand-300 text-white cursor-not-allowed'
              : 'bg-brand-600 text-white hover:bg-brand-700'"
            class="font-semibold px-6 py-3 rounded-xl transition">
            <span x-show="!fields.client_email || !fields.client_email.trim()">Add client email to send &darr;</span>
            <span x-show="fields.client_email && fields.client_email.trim()" x-cloak>📧 Create &amp; email to client &rarr;</span>
          </button>
        <% } else { %>
          <button type="submit"
            name="action" value="create_only"
            data-testid="invoice-quick-submit"
            class="bg-brand-600 text-white font-semibold px-8 py-3 rounded-xl hover:bg-brand-700 transition">
            Create invoice &rarr;
          </button>
        <% } %>
      </div>
    </div>
    <% if (canEmailFromForm) { %>
      <p class="text-xs text-gray-400 pt-1" data-testid="invoice-quick-email-hint">
        &ldquo;Email to client&rdquo; sends the invoice straight to their inbox and marks it as sent in one tap.
      </p>
    <% } %>
  </form>
</div>

<script>
  // "Continue your draft invoice" autosave (Milestone 2). Persists the
  // in-progress form fields server-side on every debounced keystroke so a
  // user who starts typing then bounces can pick up where they left off
  // (form pre-fill on next /invoices/quick GET + dashboard banner).
  // submitted=false on successful create — the server-side clear is the
  // single source of truth; the client only writes, never reads.
  function quickInvoiceAutosave(initial, initialRecentClients, initialRecentItems) {
    return {
      fields: {
        client_name: (initial && typeof initial.client_name === 'string') ? initial.client_name : '',
        client_email: (initial && typeof initial.client_email === 'string') ? initial.client_email : '',
        description: (initial && typeof initial.description === 'string') ? initial.description : '',
        amount: (initial && typeof initial.amount === 'string') ? initial.amount : ''
      },
      recentClients: Array.isArray(initialRecentClients) ? initialRecentClients : [],
      recentItems: Array.isArray(initialRecentItems) ? initialRecentItems : [],
      picked: '',
      pickedItem: '',
      submitted: false,
      init() {},
      onSubmit() { this.submitted = true; },
      // Quick-pick a previously-invoiced client. Fills name + email from the
      // selected row; the user can still edit either field after. Triggers
      // autosave() so the in-progress draft picks up the pre-filled values
      // and a bounce-then-return user sees them restored.
      fillFromRecent() {
        const idx = parseInt(this.picked, 10);
        if (Number.isNaN(idx) || idx < 0 || idx >= this.recentClients.length) return;
        const c = this.recentClients[idx];
        if (!c) return;
        this.fields.client_name = c.client_name || '';
        this.fields.client_email = c.client_email || '';
        this.autosave();
      },
      // Quick-pick a previously-billed line item. Fills description + amount
      // from the selected row; the user can still edit either field after.
      // Mirrors fillFromRecent() — autosaves the populated values so a
      // bounce-then-return user sees them restored. Bad / out-of-range
      // picks no-op silently (no throw, no field mutation).
      fillFromRecentItem() {
        const idx = parseInt(this.pickedItem, 10);
        if (Number.isNaN(idx) || idx < 0 || idx >= this.recentItems.length) return;
        const it = this.recentItems[idx];
        if (!it) return;
        if (typeof it.description === 'string') {
          this.fields.description = it.description;
        }
        const amt = Number(it.amount);
        if (Number.isFinite(amt) && amt > 0) {
          this.fields.amount = amt.toFixed(2);
        }
        this.autosave();
      },
      autosave() {
        if (this.submitted) return;
        try {
          fetch('/invoices/quick/autosave', {
            method: 'POST',
            keepalive: true,
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': '<%= locals.csrfToken || '' %>'
            },
            body: JSON.stringify({
              client_name: this.fields.client_name || '',
              client_email: this.fields.client_email || '',
              description: this.fields.description || '',
              amount: this.fields.amount == null ? '' : String(this.fields.amount)
            })
          }).catch(function () {});
        } catch (e) {}
      }
    };
  }
</script>

<%- include('partials/footer') %>

</body>
</html>
