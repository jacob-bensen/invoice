<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  const sub = (locals.submitted && typeof submitted === 'object') ? submitted : {};
  const initialClientName = typeof sub.client_name === 'string' ? sub.client_name : '';
  const initialClientEmail = typeof sub.client_email === 'string' ? sub.client_email : '';
  const initialDescription = typeof sub.description === 'string' ? sub.description : '';
  const initialAmount = typeof sub.amount === 'string' || typeof sub.amount === 'number' ? sub.amount : '';
%>

<div class="max-w-xl mx-auto px-4 py-10" data-testid="invoice-quick">
  <div class="flex items-center gap-3 mb-6">
    <a href="/invoices" class="text-gray-400 hover:text-gray-600 text-sm">&larr; Invoices</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-2xl font-bold text-gray-900">Quick invoice</h1>
  </div>

  <p class="text-sm text-gray-500 mb-6">
    Just three fields. We&rsquo;ll fill in today&rsquo;s date, a 30-day due date, and the next invoice number for you. Need line items, tax, or notes?
    <a href="/invoices/new" class="text-brand-600 underline hover:text-brand-700" data-testid="invoice-quick-advanced-link">Use the advanced form &rarr;</a>
  </p>

  <% if (locals.flash) { %>
    <div class="mb-6 p-3 rounded-lg text-sm bg-red-50 text-red-700 border border-red-200" data-testid="invoice-quick-flash">
      <%= flash.message %>
    </div>
  <% } %>

  <form action="/invoices/quick" method="POST" class="bg-white rounded-2xl border border-gray-200 p-6 space-y-4" data-testid="invoice-quick-form">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-client-name">
        Client name <span class="text-red-400">*</span>
      </label>
      <input id="quick-client-name" type="text" name="client_name" required
        placeholder="Acme Corp"
        value="<%= initialClientName %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-client-email">
        Client email <span class="text-gray-400 font-normal text-xs">(optional — needed to email the invoice)</span>
      </label>
      <input id="quick-client-email" type="email" name="client_email"
        placeholder="billing@acme.com"
        value="<%= initialClientEmail %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-description">
        What did you do? <span class="text-red-400">*</span>
      </label>
      <input id="quick-description" type="text" name="description" required
        placeholder="Logo design — June project"
        value="<%= initialDescription %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      <p class="text-xs text-gray-400 mt-1">A single line. Add more line items later by editing the invoice.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1" for="quick-amount">
        Amount (USD) <span class="text-red-400">*</span>
      </label>
      <div class="flex items-center">
        <span class="inline-flex items-center px-3 py-2 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-sm text-gray-500">$</span>
        <input id="quick-amount" type="number" name="amount" required min="0.01" step="0.01"
          placeholder="500.00"
          value="<%= initialAmount %>"
          class="flex-1 border border-gray-300 rounded-r-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>

    <div class="flex items-center justify-between pt-2">
      <a href="/invoices" class="text-gray-500 hover:text-gray-700 text-sm">Cancel</a>
      <button type="submit"
        data-testid="invoice-quick-submit"
        class="bg-brand-600 text-white font-semibold px-8 py-3 rounded-xl hover:bg-brand-700 transition">
        Create invoice &rarr;
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>

</body>
</html>
