<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,nofollow"><% } %>
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1f2937; background: #f7f7f9; margin: 0; padding: 24px; }
    .wrap { max-width: 720px; margin: 0 auto; }
    .chrome { background: #fffbeb; border: 1px solid #fcd34d; border-radius: 12px; padding: 16px 20px; margin-bottom: 16px; }
    .chrome h1 { font-size: 18px; margin: 0 0 4px 0; color: #92400e; }
    .chrome p { font-size: 14px; margin: 4px 0; color: #b45309; }
    .chrome a { color: #b45309; text-decoration: underline; font-weight: 600; }
    .meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; font-size: 13px; color: #374151; margin: 12px 0 0 0; }
    .meta dt { font-weight: 600; color: #6b7280; }
    .meta dd { margin: 0; word-break: break-all; }
    .actions { margin-top: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .actions button { background: #b45309; color: #fff; font-weight: 600; font-size: 13px; border: 0; border-radius: 8px; padding: 8px 14px; cursor: pointer; }
    .actions button:hover { background: #92400e; }
    .actions button:disabled { background: #d1a26a; cursor: default; }
    .actions .self-status { font-size: 13px; color: #166534; font-weight: 600; }
    .actions .self-status.error { color: #b91c1c; }
    iframe { width: 100%; min-height: 700px; border: 1px solid #e5e7eb; border-radius: 12px; background: white; display: block; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="chrome" data-testid="preview-email-chrome">
      <h1>📬 Preview &mdash; this is what your client will receive</h1>
      <p>No email has been sent. This is a preview of the message we&rsquo;d deliver to <strong data-testid="preview-email-recipient"><%= (invoice.client_email && String(invoice.client_email).trim()) || '(no client email set &mdash; add one on the invoice to enable email send)' %></strong>.</p>
      <p><a href="/invoices/<%= invoice.id %>" data-testid="preview-email-back">&larr; Back to invoice</a></p>
      <dl class="meta" data-testid="preview-email-meta">
        <dt>From</dt><dd><%= (user && (user.business_name || user.name)) || 'Your Business' %></dd>
        <% if (replyTo) { %><dt>Reply-To</dt><dd data-testid="preview-email-reply-to"><%= replyTo %></dd><% } %>
        <dt>Subject</dt><dd data-testid="preview-email-subject"><%= emailSubject %></dd>
      </dl>
      <% if (user && user.email) { %>
        <div class="actions" data-testid="preview-email-actions">
          <button
            type="button"
            data-testid="preview-email-self-send"
            data-invoice-id="<%= invoice.id %>"
            data-csrf="<%= locals.csrfToken || '' %>"
            data-owner-email="<%= user.email %>"
          >📨 Send test to my inbox (<%= user.email %>)</button>
          <span class="self-status" data-testid="preview-email-self-status" hidden></span>
        </div>
      <% } %>
    </div>
    <iframe
      data-testid="preview-email-iframe"
      sandbox=""
      title="Preview: client-facing invoice email"
      srcdoc="<%= emailHtml %>"
    ></iframe>
  </div>
  <% if (user && user.email) { %>
  <script data-testid="preview-email-self-script">
    (function () {
      var btn = document.querySelector('[data-testid="preview-email-self-send"]');
      if (!btn) return;
      var status = document.querySelector('[data-testid="preview-email-self-status"]');
      function setStatus(text, isError) {
        if (!status) return;
        status.hidden = false;
        if (isError) status.classList.add('error'); else status.classList.remove('error');
        status.textContent = text;
      }
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        btn.disabled = true;
        setStatus('Sending…', false);
        var id = btn.getAttribute('data-invoice-id');
        var csrf = btn.getAttribute('data-csrf') || '';
        var ownerEmail = btn.getAttribute('data-owner-email') || '';
        fetch('/invoices/' + encodeURIComponent(id) + '/email-self', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
        }).then(function (r) {
          return r.json().then(function (d) { return { ok: r.ok, data: d }; });
        }).then(function (res) {
          if (res.ok && res.data && res.data.ok) {
            var to = res.data.sent_to || ownerEmail || 'your inbox';
            setStatus('✓ Sent to ' + to + ' — check your mail client.', false);
            btn.textContent = '✓ Test sent';
          } else {
            var reason = (res.data && res.data.error) || 'send_failed';
            var msg = 'Could not send test (' + reason + ').';
            if (reason === 'not_configured') msg = 'Test send is not available yet — the operator has not finished email setup.';
            else if (reason === 'no_owner_email') msg = 'No email address on file — add one in Account Settings to use this.';
            setStatus(msg, true);
            btn.disabled = false;
          }
        }).catch(function () {
          setStatus('Network error — try again.', true);
          btn.disabled = false;
        });
      });
    })();
  </script>
  <% } %>
</body>
</html>
