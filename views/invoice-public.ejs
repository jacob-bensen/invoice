<%- include('partials/head') %>

<%
  const ownerBusinessName = invoice.owner_business_name || invoice.owner_name || 'A DecentInvoice user';
  const ownerEmail = invoice.owner_business_email || invoice.owner_email || '';
  const ownerPhone = invoice.owner_business_phone || '';
  const ownerAddress = invoice.owner_business_address || '';
  const ownerIsPaid = invoice.owner_plan === 'pro' || invoice.owner_plan === 'agency';
  const statusColors = {
    draft: 'bg-gray-100 text-gray-600',
    sent: 'bg-blue-100 text-blue-700',
    paid: 'bg-green-100 text-green-700',
    overdue: 'bg-red-100 text-red-700'
  };
  const statusLabel = invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1);
  // tapToPayLinks is pre-built on the route side (no require() in EJS scope).
  // Falls back to all-null on test/legacy callers that don't thread the local
  // so the template never throws on `tapToPay.venmo` indirection.
  const tapToPay = (typeof tapToPayLinks !== 'undefined' && tapToPayLinks)
    ? tapToPayLinks : { venmo: null, cashapp: null, paypal: null, zelle: null };
  const hasAnyTapToPay = !!(tapToPay.venmo || tapToPay.cashapp || tapToPay.paypal || tapToPay.zelle);
  // Currency-aware money formatter. The route threads `invoiceCurrency`
  // (3-letter ISO code) + `formatMoney(amount, currency)` as render
  // locals. Legacy callers / tests that don't thread either fall back to
  // 'USD' + a tiny inline formatter so the template still renders the
  // historical `$0.00` shape and never throws on `fmtMoney is not a fn`.
  const _invoiceCurrency = (typeof invoiceCurrency === 'string' && invoiceCurrency.trim())
    ? invoiceCurrency.trim().toUpperCase()
    : 'USD';
  const _fmt = (typeof formatMoney === 'function')
    ? formatMoney
    : function fallbackFormatMoney(amount, code) {
        const SYMS = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$', CHF: 'CHF ', JPY: '¥', NZD: 'NZ$' };
        const sym = SYMS[String(code || 'USD').toUpperCase()] || '$';
        const n = Number(amount);
        if (!Number.isFinite(n)) return sym + '0.00';
        return sym + n.toFixed(2);
      };
  function money(amount) { return _fmt(amount, _invoiceCurrency); }
%>

<%
  // Print stylesheet for client-side "Save as PDF" via window.print(). The
  // public /i/<token> page is wrapped in marketing chrome (header, attribution,
  // payment-claim widget, pay-now CTA, payment instructions) that's helpful in
  // the live browser flow but pollutes a print-to-PDF artifact a client would
  // file with their accounting team. The chrome elements each carry the
  // Tailwind `print:hidden` utility so they disappear from the printed sheet;
  // this @media block sets the page geometry + strips the invoice card's
  // browser-only border / shadow so it sits flush on the letter-size page.
%>
<style data-testid="public-print-styles">
  @media print {
    @page { size: letter; margin: 0.5in; }
    html, body { background: #ffffff !important; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .print-invoice-wrap { padding: 0 !important; max-width: 100% !important; }
    .print-invoice-card {
      border: none !important; box-shadow: none !important; padding: 0 !important;
    }
  }
</style>

<header class="bg-white border-b border-gray-200 px-4 py-3 print:hidden">
  <div class="max-w-4xl mx-auto flex items-center justify-between">
    <div class="text-sm text-gray-600">
      <span class="font-semibold text-gray-900"><%= ownerBusinessName %></span>
      <span class="text-gray-400"> sent you an invoice</span>
    </div>
    <a href="/" class="text-xs text-gray-400 hover:text-brand-600" data-testid="public-powered-by">
      ⚡ Powered by <span class="font-semibold">DecentInvoice</span>
    </a>
  </div>
</header>

<div class="max-w-4xl mx-auto px-4 py-10 print-invoice-wrap" data-testid="public-invoice">
  <!-- Save-as-PDF action bar (Milestone 4 — sent → paid). The client opens
       the share link, sees the invoice in-browser, and one tap saves a clean
       letter-size PDF (no marketing chrome) they can file with their
       accounting team or forward to AP. Lifts perceived professionalism of
       the share link and removes the "I can't archive this" friction that
       silently delays payment cycles. Works for every owner plan since the
       print path is purely client-side. Hidden on print itself via the
       @media-print rule above so the button doesn't end up on the PDF. -->
  <div class="flex justify-end mb-4 print:hidden gap-2" data-testid="public-print-bar">
    <%
      // "Add to calendar" — only meaningful when there's an actual due date
      // to remind about and the invoice is in an actionable state. Drafts
      // shouldn't surface a public reminder; paid invoices have no upcoming
      // action. Anchoring on sent/overdue keeps the affordance tight.
      const showCalendarDownload = invoice.due_date
        && (invoice.status === 'sent' || invoice.status === 'overdue')
        && invoice.public_token;
    %>
    <% if (showCalendarDownload) { %>
      <a
        href="/i/<%= invoice.public_token %>/calendar.ics"
        download
        data-testid="public-calendar-download"
        class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm flex items-center gap-2"
        aria-label="Add invoice due date to your calendar"
      >
        <span aria-hidden="true">📅</span>
        Add to calendar
      </a>
    <% } %>
    <button
      type="button"
      onclick="window.print()"
      data-testid="public-print-button"
      class="border border-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm flex items-center gap-2"
      aria-label="Download this invoice as a PDF"
    >
      <span aria-hidden="true">📄</span>
      Save as PDF
    </button>
  </div>
  <!-- Pay-now hero (Pro/Agency owner with an attached Stripe payment link) -->
  <% if (invoice.payment_link_url && ownerIsPaid && invoice.status !== 'paid') { %>
    <div class="bg-white rounded-2xl border border-brand-200 shadow-sm p-6 mb-6 flex flex-wrap items-center gap-4 print:hidden" data-testid="public-pay-cta">
      <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-brand-700 uppercase tracking-wide mb-1">Pay this invoice</p>
        <p class="text-gray-700 text-sm">
          Pay <%= money(invoice.total) %> to
          <span class="font-semibold"><%= ownerBusinessName %></span>
          securely via Stripe.
        </p>
      </div>
      <a href="<%= invoice.payment_link_url %>" target="_blank" rel="noopener"
        class="bg-brand-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-700 transition whitespace-nowrap">
        Pay <%= money(invoice.total) %> →
      </a>
    </div>
  <% } %>

  <% if (invoice.status === 'paid') { %>
    <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 mb-6 text-sm" data-testid="public-paid-banner">
      <span class="font-semibold">Paid.</span> Thanks — this invoice has been settled.
    </div>
  <% } %>

  <!-- Tap-to-pay deep-link buttons (Milestone 4 — first invoice sent →
       first payment received). When the freelancer has saved a Venmo,
       Cash App, or PayPal.me handle in /billing/settings, every share-link
       view renders a one-tap button per app. Each button is a universal
       link with the invoice's amount + number pre-filled, so the client's
       mobile OS opens the app at the "send payment" screen — collapsing
       the four-step copy / app-switch / paste / type flow into a single
       tap on the dominant P2P cohort. Suppressed on `paid` invoices (no
       payment action remaining) and on the print path (universal links
       are useless on a PDF). Renders alongside the Stripe Pay CTA above
       — clients have a payment-method preference, and the more rails we
       surface in one place, the higher the chance any of them lands. -->
  <% if (hasAnyTapToPay && invoice.status !== 'paid') { %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-6 print:hidden" data-testid="public-tap-to-pay">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Pay instantly</p>
      <div class="flex flex-wrap gap-2">
        <% if (tapToPay.venmo) { %>
          <a href="<%= tapToPay.venmo %>" target="_blank" rel="noopener"
             data-testid="public-tap-to-pay-venmo"
             class="inline-flex items-center gap-2 bg-[#3D95CE] text-white font-semibold px-4 py-2 rounded-lg hover:bg-[#3580B3] transition text-sm">
            <span aria-hidden="true">📲</span>
            Pay with Venmo
          </a>
        <% } %>
        <% if (tapToPay.cashapp) { %>
          <a href="<%= tapToPay.cashapp %>" target="_blank" rel="noopener"
             data-testid="public-tap-to-pay-cashapp"
             class="inline-flex items-center gap-2 bg-[#00C244] text-white font-semibold px-4 py-2 rounded-lg hover:bg-[#00A93B] transition text-sm">
            <span aria-hidden="true">💵</span>
            Pay with Cash App
          </a>
        <% } %>
        <% if (tapToPay.paypal) { %>
          <a href="<%= tapToPay.paypal %>" target="_blank" rel="noopener"
             data-testid="public-tap-to-pay-paypal"
             class="inline-flex items-center gap-2 bg-[#0070BA] text-white font-semibold px-4 py-2 rounded-lg hover:bg-[#005A98] transition text-sm">
            <span aria-hidden="true">💳</span>
            Pay with PayPal
          </a>
        <% } %>
      </div>
      <% if (tapToPay.zelle) { %>
        <%
          // Zelle has no universal deep-link — it lives entirely inside
          // bank apps. The surface is a tap-to-copy handle + a short
          // instruction. The client copies the handle, opens their own
          // bank's Zelle section, pastes the handle, types the amount,
          // and sends — same number of steps as the manual flow today,
          // but the handle is no longer hand-transcribed (the dominant
          // typo / wrong-recipient risk on Zelle).
          const zelleAmountLabel = money(invoice.total);
        %>
        <div class="mt-3 pt-3 border-t border-gray-100" data-testid="public-tap-to-pay-zelle"
             x-data="{ copied: false, async copy() { try { await navigator.clipboard.writeText('<%= tapToPay.zelle.handle %>'); this.copied = true; setTimeout(() => this.copied = false, 2500); } catch (e) {} } }">
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-0">
              <p class="text-xs font-semibold text-purple-700 uppercase tracking-wide">Pay with Zelle</p>
              <p class="text-sm text-gray-700 mt-0.5">
                <span class="text-gray-500"><%= tapToPay.zelle.kind === 'email' ? 'Send ' + zelleAmountLabel + ' to' : 'Send ' + zelleAmountLabel + ' to phone' %>:</span>
                <span class="font-mono font-semibold text-gray-900 break-all" data-testid="public-tap-to-pay-zelle-handle"><%= tapToPay.zelle.display %></span>
              </p>
            </div>
            <button type="button" @click="copy()"
                    data-testid="public-tap-to-pay-zelle-copy"
                    class="inline-flex items-center gap-2 bg-[#6D1ED4] text-white font-semibold px-4 py-2 rounded-lg hover:bg-[#5818AB] transition text-sm whitespace-nowrap">
              <span aria-hidden="true">📋</span>
              <span x-show="!copied">Copy Zelle handle</span>
              <span x-show="copied" x-cloak>Copied ✓</span>
            </button>
          </div>
          <p class="text-xs text-gray-400 mt-2">Open your bank's app, find Zelle (or "Send money"), and send <%= zelleAmountLabel %> to this <%= tapToPay.zelle.kind %>. Most US banks include Zelle for free.</p>
        </div>
      <% } %>
      <p class="text-xs text-gray-400 mt-3">Tapping opens the app with the amount pre-filled. Send to <span class="font-semibold"><%= ownerBusinessName %></span>.</p>
    </div>
  <% } %>

  <!-- "How to pay" instructions (Milestone 4 — first invoice sent → first
       payment received). When the freelancer has filled in their payment
       methods in /billing/settings, every client opening the share link
       sees a clear path to actually paying. Critical for free-tier users
       who have no Stripe Pay button, and useful as a fallback for Pro
       users whose clients prefer ACH / bank transfer over card. Hidden on
       paid invoices — once settled the block is noise. -->
  <% if (invoice.owner_payment_instructions && invoice.status !== 'paid') { %>
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-6 print:hidden" data-testid="public-payment-instructions">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">How to pay</p>
      <p class="text-gray-700 text-sm whitespace-pre-line font-mono"><%= invoice.owner_payment_instructions %></p>
    </div>
  <% } %>

  <!-- Client-side payment-claim widget (Milestone 4 — sent → paid). The
       client who pays via Venmo/Zelle/wire (the "How to pay" instructions
       above) clicks here to tell the freelancer the money's been sent.
       Stamps payment_claimed_at, emails the freelancer immediately, and
       surfaces a "💸 Client reports payment" badge on their dashboard.
       Hidden on paid invoices and once the claim has been recorded; a
       confirmation panel takes its place after submit. Justifies the
       page even for free-tier users whose freelancer has no Stripe Pay
       button — without this, the only out-of-band payment path went
       silently from "client paid via Venmo" → "freelancer notices the
       bank deposit days later and manually marks paid." -->
  <% if (typeof justClaimed !== 'undefined' && justClaimed) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl px-5 py-4 mb-6 text-sm print:hidden" data-testid="payment-claim-success">
      <p class="font-semibold">Thanks &mdash; we&rsquo;ve let <%= invoice.owner_business_name || invoice.owner_name || 'the sender' %> know.</p>
      <p class="text-emerald-800 mt-1">They&rsquo;ll verify the funds and mark this invoice paid. You&rsquo;ll see &ldquo;Paid&rdquo; here once they confirm.</p>
    </div>
  <% } %>
  <% if (invoice.payment_claimed_at && invoice.status !== 'paid') { %>
    <div class="bg-white rounded-2xl border border-amber-200 shadow-sm p-6 mb-6 print:hidden" data-testid="public-payment-claimed-panel">
      <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-2">Payment reported</p>
      <p class="text-gray-700 text-sm">
        You&rsquo;ve already told <strong><%= invoice.owner_business_name || invoice.owner_name || 'the sender' %></strong>
        that this invoice was paid<% if (invoice.payment_claim_method) { %> via
        <strong data-testid="public-payment-claimed-method"><%= invoice.payment_claim_method.replace('_', ' ') %></strong><% } %>.
        They&rsquo;ll mark the invoice paid once the funds clear on their side.
      </p>
    </div>
  <% } else if ((invoice.status === 'sent' || invoice.status === 'overdue') && !invoice.payment_claimed_at) { %>
    <% const methods = (typeof paymentClaimMethods !== 'undefined' && paymentClaimMethods) ? paymentClaimMethods : ['cash','check','venmo','zelle','bank_transfer','paypal','other']; %>
    <% const refMax = (typeof paymentClaimReferenceMax !== 'undefined' && paymentClaimReferenceMax) || 200; %>
    <% const noteMax = (typeof paymentClaimNoteMax !== 'undefined' && paymentClaimNoteMax) || 1000; %>
    <% const methodLabels = { cash: 'Cash', check: 'Cheque / Check', venmo: 'Venmo', zelle: 'Zelle', bank_transfer: 'Bank transfer / ACH', paypal: 'PayPal', other: 'Other' }; %>
    <details class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-6 group print:hidden" data-testid="public-payment-claim">
      <summary class="flex flex-wrap items-center gap-3 cursor-pointer list-none">
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Already paid?</p>
          <p class="text-gray-700 text-sm">Let <strong><%= invoice.owner_business_name || invoice.owner_name || 'the sender' %></strong> know the money&rsquo;s on its way.</p>
        </div>
        <span class="bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg group-open:hidden whitespace-nowrap" data-testid="public-payment-claim-open">
          I&rsquo;ve sent payment
        </span>
      </summary>

      <form
        method="POST"
        action="/i/<%= invoice.public_token %>/payment-claim"
        class="space-y-4 mt-4"
        data-testid="public-payment-claim-form"
      >
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">How did you pay?</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" data-testid="public-payment-claim-methods">
            <% methods.forEach((m, idx) => { %>
              <label class="flex items-center gap-2 border border-gray-200 rounded-lg px-3 py-2 cursor-pointer hover:border-emerald-300 hover:bg-emerald-50 text-sm">
                <input
                  type="radio"
                  name="method"
                  value="<%= m %>"
                  <% if (idx === 0) { %>required<% } %>
                  class="text-emerald-600 focus:ring-emerald-500"
                  data-testid="public-payment-claim-method-<%= m %>"
                >
                <span><%= methodLabels[m] || m %></span>
              </label>
            <% }) %>
          </div>
        </div>
        <div>
          <label for="claim-reference" class="block text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Reference (optional)</label>
          <input
            id="claim-reference"
            type="text"
            name="reference"
            maxlength="<%= refMax %>"
            placeholder="e.g. transaction ID, cheque #, Venmo @handle"
            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-emerald-400 focus:ring focus:ring-emerald-100 focus:outline-none"
          >
        </div>
        <div>
          <label for="claim-note" class="block text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Note (optional)</label>
          <textarea
            id="claim-note"
            name="note"
            rows="2"
            maxlength="<%= noteMax %>"
            placeholder="Anything they should know &mdash; e.g. &lsquo;sent from my business account&rsquo;"
            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-emerald-400 focus:ring focus:ring-emerald-100 focus:outline-none"
          ></textarea>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="bg-emerald-600 text-white font-semibold px-5 py-2 rounded-lg hover:bg-emerald-700 transition"
            data-testid="public-payment-claim-submit"
          >
            Notify <%= invoice.owner_business_name || invoice.owner_name || 'the sender' %>
          </button>
          <p class="text-xs text-gray-400 ml-auto">DecentInvoice doesn&rsquo;t move money &mdash; the sender confirms once the funds land.</p>
        </div>
      </form>
    </details>
  <% } %>

  <!-- Invoice card -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 md:p-12 print-invoice-card">
    <div class="flex justify-between items-start mb-10">
      <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= ownerBusinessName %></h2>
        <% if (ownerAddress) { %>
          <p class="text-gray-400 text-sm mt-1 whitespace-pre-line"><%= ownerAddress %></p>
        <% } %>
        <% if (ownerEmail) { %>
          <p class="text-gray-400 text-sm"><%= ownerEmail %></p>
        <% } %>
        <% if (ownerPhone) { %>
          <p class="text-gray-400 text-sm"><%= ownerPhone %></p>
        <% } %>
      </div>
      <div class="text-right">
        <div class="text-3xl font-extrabold text-brand-600">INVOICE</div>
        <div class="text-gray-500 text-sm mt-1">#<%= invoice.invoice_number %></div>
        <span class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full mt-2 <%= statusColors[invoice.status] || 'bg-gray-100 text-gray-600' %>">
          <%= statusLabel %>
        </span>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-10">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Bill To</p>
        <p class="font-semibold text-gray-800"><%= invoice.client_name %></p>
        <% if (invoice.client_email) { %><p class="text-gray-500 text-sm"><%= invoice.client_email %></p><% } %>
        <% if (invoice.client_address) { %><p class="text-gray-500 text-sm whitespace-pre-line"><%= invoice.client_address %></p><% } %>
      </div>
      <div class="text-right">
        <div class="space-y-1 text-sm">
          <div class="flex justify-end gap-8">
            <span class="text-gray-400">Issue Date</span>
            <span class="font-medium text-gray-700"><%= new Date(invoice.issued_date).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) %></span>
          </div>
          <% if (invoice.due_date) { %>
          <div class="flex justify-end gap-8">
            <span class="text-gray-400">Due Date</span>
            <span class="font-medium text-gray-700"><%= new Date(invoice.due_date).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) %></span>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <table class="w-full text-sm mb-6">
      <thead>
        <tr class="border-b-2 border-gray-200">
          <th class="text-left py-2 text-gray-500 font-semibold">Description</th>
          <th class="text-center py-2 text-gray-500 font-semibold w-20">Qty</th>
          <th class="text-right py-2 text-gray-500 font-semibold w-28">Unit Price</th>
          <th class="text-right py-2 text-gray-500 font-semibold w-28">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% (invoice.items || []).forEach(item => { %>
          <tr class="border-b border-gray-100">
            <td class="py-3 text-gray-700"><%= item.description %></td>
            <td class="py-3 text-center text-gray-500"><%= item.quantity %></td>
            <td class="py-3 text-right text-gray-500"><%= money(item.unit_price) %></td>
            <td class="py-3 text-right font-medium text-gray-800"><%= money(item.quantity * item.unit_price) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="flex justify-end mb-8">
      <div class="w-64 space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Subtotal</span>
          <span class="font-medium"><%= money(invoice.subtotal) %></span>
        </div>
        <% if (parseFloat(invoice.tax_rate) > 0) { %>
          <div class="flex justify-between">
            <span class="text-gray-500">Tax (<%= invoice.tax_rate %>%)</span>
            <span class="font-medium"><%= money(invoice.tax_amount) %></span>
          </div>
        <% } %>
        <div class="flex justify-between border-t border-gray-200 pt-2">
          <span class="font-bold text-gray-800">Total</span>
          <span class="font-bold text-xl text-gray-900" data-testid="public-invoice-total"><%= money(invoice.total) %></span>
        </div>
      </div>
    </div>

    <% if (invoice.notes) { %>
      <div class="border-t border-gray-100 pt-6">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Notes</p>
        <p class="text-gray-500 text-sm whitespace-pre-line"><%= invoice.notes %></p>
      </div>
    <% } %>
  </div>

  <!-- Powered-by attribution footer (#48 hook). Surfaces DecentInvoice to
       every client who receives a Pro user's share link — a passive
       acquisition channel that compounds with every invoice sent. -->
  <p class="text-center text-xs text-gray-400 mt-8 print:hidden" data-testid="public-attribution">
    Sent via <a href="/" class="font-semibold text-brand-600 hover:underline">⚡ DecentInvoice</a> —
    <a href="/auth/register" class="hover:underline">send your own invoice in 60 seconds</a>.
  </p>
</div>

</body>
</html>
