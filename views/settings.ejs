<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  // Currency dropdown source — falls back to a hard-coded list when the
  // render local isn't threaded (legacy tests / partial mocks) so the
  // <select> never renders empty. The canonical list lives in
  // lib/currency.js#SUPPORTED_CURRENCIES.
  const currencyOptions = (typeof supportedCurrencies !== 'undefined' && Array.isArray(supportedCurrencies))
    ? supportedCurrencies
    : [
        { code: 'USD', symbol: '$',    label: 'US Dollar (USD $)' },
        { code: 'EUR', symbol: '€',    label: 'Euro (EUR €)' },
        { code: 'GBP', symbol: '£',    label: 'British Pound (GBP £)' },
        { code: 'CAD', symbol: 'CA$',  label: 'Canadian Dollar (CAD CA$)' },
        { code: 'AUD', symbol: 'A$',   label: 'Australian Dollar (AUD A$)' },
        { code: 'NZD', symbol: 'NZ$',  label: 'New Zealand Dollar (NZD NZ$)' },
        { code: 'CHF', symbol: 'CHF ', label: 'Swiss Franc (CHF)' },
        { code: 'JPY', symbol: '¥',    label: 'Japanese Yen (JPY ¥)' }
      ];
  const selectedCurrency = (user && typeof user.default_currency === 'string' && user.default_currency.trim())
    ? user.default_currency.trim().toUpperCase()
    : 'USD';
  let selectedPaymentTermsDays = 30;
  if (user && user.default_payment_terms_days != null) {
    const _td = parseInt(user.default_payment_terms_days, 10);
    if (Number.isFinite(_td) && _td >= 1 && _td <= 365) selectedPaymentTermsDays = _td;
  }
  // Default tax rate (percentage, 0-100, up to 2 decimals). 0 → "no
  // default" — the historical behaviour the GET /invoices/new form has
  // always rendered. The rendered <input> uses `step="0.01"` so a
  // freelancer in a 8.875% sales-tax jurisdiction can store exactly that.
  let selectedTaxRate = 0;
  if (user && user.default_tax_rate != null) {
    const _trd = parseFloat(user.default_tax_rate);
    if (Number.isFinite(_trd) && _trd >= 0 && _trd <= 100) selectedTaxRate = _trd;
  }
  // Invoice number prefix — NULL / empty ⇒ shown as empty input, and
  // the server-side resolver falls back to the historical INV-YYYY- on
  // the next getNextInvoiceNumber call. Defence-in-depth on rendering:
  // a corrupt DB row (non-string / too long) collapses to empty rather
  // than projecting the hostile value.
  let selectedInvoicePrefix = '';
  if (user && typeof user.invoice_number_prefix === 'string') {
    const _p = user.invoice_number_prefix.trim();
    if (_p.length > 0 && _p.length <= 20) selectedInvoicePrefix = _p;
  }
  // Invoice number start — schema DEFAULT 1. Defence-in-depth: an
  // out-of-range corrupt row falls back to 1 in the rendered input.
  let selectedInvoiceStart = 1;
  if (user && user.invoice_number_start != null) {
    const _sn = parseInt(user.invoice_number_start, 10);
    if (Number.isFinite(_sn) && _sn >= 1 && _sn <= 999999) selectedInvoiceStart = _sn;
  }
  const _invoicePrefixDefault = `INV-${new Date().getFullYear()}-`;
%>

<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Account Settings</h1>
  <p class="text-gray-500 text-sm mb-8">These details appear on every invoice you send. Filling them in makes your invoices look more professional and helps clients reach you.</p>

  <% if (locals.flash) { %>
    <div class="mb-6 p-3 rounded-lg text-sm <%= flash.type === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200' %>">
      <%= flash.message %>
    </div>
  <% } %>

  <div class="bg-white rounded-2xl border border-gray-200 p-8">
    <form action="/billing/settings" method="POST" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
        <input type="text" name="name" value="<%= user.name || '' %>" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Business Name</label>
        <input type="text" name="business_name" value="<%= user.business_name || '' %>" placeholder="Optional — leave blank to use your name"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Business Address</label>
        <textarea name="business_address" rows="3" placeholder="123 Main St&#10;City, State 12345"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= user.business_address || '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Business Email</label>
          <input type="email" name="business_email" value="<%= user.business_email || '' %>" placeholder="<%= user.email %>"
            class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Business Phone</label>
          <input type="tel" name="business_phone" value="<%= user.business_phone || '' %>" placeholder="+1 (555) 000-0000"
            class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Reply-to email <span class="text-gray-400 font-normal">(optional)</span></label>
        <input type="email" name="reply_to_email" value="<%= user.reply_to_email || '' %>" placeholder="<%= user.business_email || user.email %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <p class="text-xs text-gray-500 mt-1">When clients reply to invoice emails, replies go here. Defaults to your business email.</p>
      </div>
      <div>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="bcc_invoice_emails" value="1" <%= user.bcc_invoice_emails ? 'checked' : '' %>
            data-testid="settings-bcc-invoice-emails"
            class="mt-0.5 h-4 w-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <span>
            <span class="block text-sm font-medium text-gray-700">Send me a copy of every invoice I email</span>
            <span class="block text-xs text-gray-500 mt-0.5">A silent BCC of the same email goes to <%= user.email %> so you have a paper trail in your own inbox.</span>
          </span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">How clients can pay you <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="payment_instructions" rows="4" maxlength="2000" data-testid="settings-payment-instructions"
          placeholder="Venmo @yourhandle&#10;Zelle: you@bank.com&#10;Bank: Chase, routing 021000021, acct 1234567890&#10;Cheque to: Your Name, 123 Main St"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono"><%= user.payment_instructions || '' %></textarea>
        <p class="text-xs text-gray-500 mt-1">Shown on every invoice your client opens via a share link. List the methods you accept — bank transfer, Venmo, Zelle, PayPal, cheque, anything.</p>
      </div>
      <div class="border-t border-gray-100 pt-4">
        <p class="text-sm font-medium text-gray-700 mb-1">Tap-to-pay handles <span class="text-gray-400 font-normal">(optional)</span></p>
        <p class="text-xs text-gray-500 mb-3">When set, each invoice's public share link renders a one-tap button that opens the app with the amount pre-filled. Enter just the handle — no <code class="bg-gray-100 rounded px-1">@</code>, no <code class="bg-gray-100 rounded px-1">$</code>, no URL.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="venmo_handle" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Venmo</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm pointer-events-none">@</span>
              <input id="venmo_handle" type="text" name="venmo_handle" value="<%= user.venmo_handle || '' %>"
                placeholder="yourhandle" maxlength="64"
                data-testid="settings-venmo-handle"
                class="w-full border border-gray-300 rounded-lg pl-7 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
            </div>
          </div>
          <div>
            <label for="cashapp_handle" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Cash App</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm pointer-events-none">$</span>
              <input id="cashapp_handle" type="text" name="cashapp_handle" value="<%= user.cashapp_handle || '' %>"
                placeholder="yourtag" maxlength="64"
                data-testid="settings-cashapp-handle"
                class="w-full border border-gray-300 rounded-lg pl-7 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
            </div>
          </div>
          <div>
            <label for="paypal_me_handle" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">PayPal.me</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-[11px] pointer-events-none">paypal.me/</span>
              <input id="paypal_me_handle" type="text" name="paypal_me_handle" value="<%= user.paypal_me_handle || '' %>"
                placeholder="yourname" maxlength="64"
                data-testid="settings-paypal-me-handle"
                class="w-full border border-gray-300 rounded-lg pl-[68px] pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
            </div>
          </div>
        </div>
        <div class="mt-3">
          <label for="zelle_handle" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Zelle</label>
          <input id="zelle_handle" type="text" name="zelle_handle" value="<%= user.zelle_handle || '' %>"
            placeholder="you@bank.com or +1 555 123 4567" maxlength="254"
            data-testid="settings-zelle-handle"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
          <p class="text-xs text-gray-500 mt-1">The email address or phone number you've registered with your bank for Zelle. Clients tap to copy it on the invoice share page, then send via their own bank's Zelle.</p>
        </div>
      </div>
      <div>
        <label for="default_currency" class="block text-sm font-medium text-gray-700 mb-1">Currency</label>
        <select id="default_currency" name="default_currency"
          data-testid="settings-default-currency"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white">
          <% currencyOptions.forEach(function (opt) { %>
            <option value="<%= opt.code %>"<%= opt.code === selectedCurrency ? ' selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
        <p class="text-xs text-gray-500 mt-1">Shown on every invoice your client sees and used for the PayPal pay-link. Pick the currency you usually bill in.</p>
      </div>
      <div>
        <label for="default_payment_terms_days" class="block text-sm font-medium text-gray-700 mb-1">Default payment terms</label>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">Net</span>
          <input id="default_payment_terms_days" type="number" name="default_payment_terms_days"
            min="1" max="365" step="1" value="<%= selectedPaymentTermsDays %>"
            data-testid="settings-default-payment-terms-days"
            class="w-24 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <span class="text-sm text-gray-500">days</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">Sets the due-date offset on every new invoice. Common: 7 (weekly), 14 (Net 14), 15 (mid-month), 30 (Net 30, default), 45, 60.</p>
      </div>
      <div>
        <label for="default_tax_rate" class="block text-sm font-medium text-gray-700 mb-1">Default tax rate</label>
        <div class="flex items-center gap-2">
          <input id="default_tax_rate" type="number" name="default_tax_rate"
            min="0" max="100" step="0.01" value="<%= selectedTaxRate %>"
            data-testid="settings-default-tax-rate"
            class="w-24 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <span class="text-sm text-gray-500">%</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">Pre-fills the Tax % on every new invoice. Use <code class="bg-gray-100 rounded px-1">0</code> if you don&rsquo;t charge tax. Common: 7.25% (US sales tax — CA), 8.875% (NYC), 19% (DE VAT), 20% (UK/FR VAT), 21% (NL/ES VAT), 25% (NO/SE/DK VAT).</p>
      </div>
      <div>
        <label for="invoice_number_prefix" class="block text-sm font-medium text-gray-700 mb-1">Invoice number prefix <span class="text-gray-400 font-normal">(optional)</span></label>
        <input id="invoice_number_prefix" type="text" name="invoice_number_prefix"
          maxlength="20" value="<%= selectedInvoicePrefix %>"
          placeholder="<%= _invoicePrefixDefault %>"
          data-testid="settings-invoice-number-prefix"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
        <p class="text-xs text-gray-500 mt-1">Prepended to every new invoice number. Leave blank for the default (<code class="bg-gray-100 rounded px-1"><%= _invoicePrefixDefault %></code>). Common: <code class="bg-gray-100 rounded px-1">ACME-</code>, <code class="bg-gray-100 rounded px-1">ACME-<%= new Date().getFullYear() %>-</code>, <code class="bg-gray-100 rounded px-1"><%= new Date().getFullYear() %>-</code>. Up to 20 characters.</p>
      </div>
      <div>
        <label for="invoice_number_start" class="block text-sm font-medium text-gray-700 mb-1">Starting invoice number</label>
        <div class="flex items-center gap-2">
          <input id="invoice_number_start" type="number" name="invoice_number_start"
            min="1" max="999999" step="1" value="<%= selectedInvoiceStart %>"
            data-testid="settings-invoice-number-start"
            class="w-32 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <p class="text-xs text-gray-500 mt-1">Your first invoice will be numbered <code class="bg-gray-100 rounded px-1"><%= selectedInvoicePrefix || _invoicePrefixDefault %><%= String(selectedInvoiceStart).padStart(4, '0') %></code>. Bump this to <code class="bg-gray-100 rounded px-1">100</code> or <code class="bg-gray-100 rounded px-1">1000</code> so your first invoice doesn&rsquo;t announce itself as your first — useful when moving from another invoicing tool.</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Default invoice notes <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="default_invoice_notes" rows="3" maxlength="2000" data-testid="settings-default-invoice-notes"
          placeholder="Net 30. Late fee 1.5%/month past due.&#10;Thanks for your business!"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= user.default_invoice_notes || '' %></textarea>
        <p class="text-xs text-gray-500 mt-1">Pre-filled into the notes section on every new invoice you create. Payment terms, late-fee policy, or a thank-you line — write it once.</p>
      </div>
      <div class="pt-2">
        <button type="submit" class="bg-brand-600 text-white font-semibold px-6 py-2.5 rounded-lg hover:bg-brand-700 transition">
          Save Settings
        </button>
      </div>
    </form>
  </div>

  <!-- Zapier / Outbound Webhook (Pro only) -->
  <div class="bg-white rounded-2xl border border-gray-200 p-8 mt-6">
    <div class="flex items-center justify-between mb-2">
      <h2 class="font-semibold text-gray-700">Zapier / Webhook</h2>
      <span class="bg-brand-100 text-brand-700 text-[10px] font-bold px-2 py-0.5 rounded-full">PRO</span>
    </div>
    <p class="text-sm text-gray-500 mb-4">
      Get notified the moment an invoice is paid. We'll POST a JSON event to your URL — paste it into a Zapier
      or Make catch-hook to trigger Slack pings, Google Sheets rows, anything.
    </p>
    <% if (user.plan === 'pro' || user.plan === 'agency') { %>
      <form action="/billing/webhook-url" method="POST" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <input type="url" name="webhook_url" value="<%= user.webhook_url || '' %>"
          placeholder="https://hooks.zapier.com/hooks/catch/..."
          pattern="https?://.+"
          class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono">
        <div class="flex items-center gap-3">
          <button type="submit" class="bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 transition">
            Save webhook
          </button>
          <% if (user.webhook_url) { %>
            <span class="text-xs text-green-700">✓ Webhook configured</span>
          <% } %>
        </div>
      </form>
      <details class="mt-4 text-xs text-gray-500">
        <summary class="cursor-pointer">Payload shape</summary>
        <pre class="bg-gray-50 rounded p-3 mt-2 overflow-x-auto text-[11px]">{
  "event": "invoice.paid",
  "invoice_id": 123,
  "invoice_number": "INV-2026-0123",
  "amount": 500,
  "currency": "usd",
  "client_name": "Acme Corp",
  "client_email": "billing@acme.com",
  "paid_at": "2026-04-23T14:30:00.000Z"
}</pre>
      </details>

      <div class="mt-5 border-t border-gray-100 pt-4 space-y-2">
        <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide">Quick start</p>
        <details class="text-xs text-gray-600">
          <summary class="cursor-pointer font-medium text-gray-700">💬 Use with Slack</summary>
          <div class="mt-2 space-y-2 pl-1">
            <ol class="list-decimal pl-4 space-y-1">
              <li>Open your Slack workspace, then go to <strong>Apps</strong> → <strong>Manage</strong> → <strong>Custom Integrations</strong> → <strong>Incoming Webhooks</strong>.</li>
              <li>Click <strong>Add to Slack</strong>, choose the channel, and copy the generated <code class="bg-gray-100 rounded px-1">https://hooks.slack.com/services/…</code> URL.</li>
              <li>Paste it above and save. Each paid invoice will post a message like <em>“💸 Invoice INV-2026-0123 paid by Acme Corp — $500.00”</em>.</li>
            </ol>
            <p class="text-gray-400 text-[11px]">No formatting setup needed — QuickInvoice detects Slack URLs and sends the right payload automatically.</p>
          </div>
        </details>
        <details class="text-xs text-gray-600">
          <summary class="cursor-pointer font-medium text-gray-700">🎮 Use with Discord</summary>
          <div class="mt-2 space-y-2 pl-1">
            <ol class="list-decimal pl-4 space-y-1">
              <li>In your Discord server, open the channel and click the gear icon → <strong>Integrations</strong> → <strong>Webhooks</strong>.</li>
              <li>Click <strong>New Webhook</strong>, name it (e.g. “Invoices”), then copy the URL — it starts with <code class="bg-gray-100 rounded px-1">https://discord.com/api/webhooks/…</code>.</li>
              <li>Paste it above and save. Paid invoices will post in the channel automatically.</li>
            </ol>
          </div>
        </details>
        <details class="text-xs text-gray-600">
          <summary class="cursor-pointer font-medium text-gray-700">⚡ Use with Zapier or Make</summary>
          <div class="mt-2 pl-1 text-gray-500">
            Use any catch-hook URL (Zapier, Make, n8n, your own server). QuickInvoice will POST the JSON shape shown above.
          </div>
        </details>
      </div>
    <% } else { %>
      <%- include('partials/pro-lock', { proLock: {
        feature: 'webhook',
        icon: '🔗',
        headline: 'Pipe every paid invoice into Slack, Zapier, or a spreadsheet',
        benefit: 'Pro fires a JSON POST the moment any invoice is marked paid — paste a Zapier or Make hook URL above and stop chasing payments in three different tabs.'
      } }) %>
    <% } %>
  </div>

  <!-- Plan info -->
  <div class="bg-white rounded-2xl border border-gray-200 p-8 mt-6" x-data="settingsPlan()">
    <h2 class="font-semibold text-gray-700 mb-4">Subscription</h2>
    <div class="flex items-center justify-between mb-5">
      <div>
        <p class="font-medium text-gray-800">
          <% if (user.plan === 'pro') { %>
            <span class="bg-brand-100 text-brand-700 text-xs font-bold px-2 py-0.5 rounded-full mr-2">PRO</span>
            Pro Plan · Active subscription
          <% } else { %>
            Free Plan · <%= user.invoice_count %>/3 invoices used
          <% } %>
        </p>
      </div>
      <% if (user.plan === 'pro') { %>
        <form action="/billing/portal" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button class="text-sm text-brand-600 hover:underline font-medium">Manage subscription</button>
        </form>
      <% } %>
    </div>

    <% if (user.plan !== 'pro') { %>
      <!-- Upgrade selector with billing-cycle toggle -->
      <div class="border-t border-gray-100 pt-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Upgrade to Pro</p>
        <div class="flex items-center gap-3 mb-4">
          <button
            type="button"
            @click="cycle = 'monthly'"
            :class="cycle === 'monthly' ? 'bg-brand-50 text-brand-700 border-brand-200' : 'bg-white text-gray-500 border-gray-200 hover:text-gray-700'"
            class="px-3 py-1.5 rounded-lg text-sm font-semibold transition border"
          >Monthly — $12/mo</button>
          <button
            type="button"
            @click="cycle = 'annual'"
            :class="cycle === 'annual' ? 'bg-brand-50 text-brand-700 border-brand-200' : 'bg-white text-gray-500 border-gray-200 hover:text-gray-700'"
            class="px-3 py-1.5 rounded-lg text-sm font-semibold transition border flex items-center gap-2"
          >
            Annual — $99/yr
            <span class="bg-green-100 text-green-700 text-[10px] font-bold px-1.5 py-0.5 rounded">Save 31%</span>
          </button>
        </div>
        <p class="text-xs font-semibold mb-3" x-show="cycle === 'annual'" x-cloak>
          <span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 px-2 py-1 rounded-full">
            <span aria-hidden="true">💰</span>
            Save $45/year vs. paying monthly
          </span>
        </p>
        <form action="/billing/create-checkout" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <input type="hidden" name="billing_cycle" :value="cycle">
          <button type="submit" class="bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 transition">
            Start 7-day free trial &rarr;
          </button>
          <p class="text-xs text-gray-500 mt-2">No credit card required. Cancel anytime.</p>
        </form>
      </div>
    <% } %>
  </div>
</div>

<script>
  function settingsPlan() {
    return { cycle: 'monthly' };
  }
</script>

<%- include('partials/footer') %>

</body>
</html>
